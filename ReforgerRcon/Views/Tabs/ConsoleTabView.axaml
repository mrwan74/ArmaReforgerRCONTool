<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vm="using:ReforgerRcon.ViewModels"
             xmlns:models="using:ReforgerRcon.Models"
             x:Class="ReforgerRcon.Views.Tabs.ConsoleTabView"
             x:DataType="vm:ConsoleViewModel">

  <Grid RowDefinitions="Auto,*,Auto" Margin="14,8,14,10">
    <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,*,Auto" Margin="0,0,0,8" VerticalAlignment="Center">
      <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
        <icons:MaterialIcon Kind="Console" Width="16" Height="16" Foreground="{DynamicResource LuminaPrimaryBrush}" />
        <TextBlock Text="RCON Console" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0" />
      </StackPanel>

      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
        <Button Classes="Small Outline" Content="ALL" Command="{Binding SetCategoryCommand}" CommandParameter="All" />
        <Button Classes="Small Outline" Content="RCON" Command="{Binding SetCategoryCommand}" CommandParameter="RCON" />
        <Button Classes="Small Outline" Content="System" Command="{Binding SetCategoryCommand}" CommandParameter="System" />
      </StackPanel>

      <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
        <CheckBox Content="Auto-scroll" IsChecked="{Binding AutoScroll}" Classes="Small" VerticalAlignment="Center" Margin="0,0,4,0" />

        <Button Classes="Small Outline" 
                Command="{Binding ToggleFullscreenCommand}" 
                ToolTip.Tip="Toggle Fullscreen Console"
                IsVisible="{Binding !IsDetached}">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <icons:MaterialIcon Kind="Fullscreen" Width="14" Height="14" />
            <TextBlock Text="Fullscreen" />
          </StackPanel>
        </Button>

        <Button Classes="Small Outline" 
                Command="{Binding DetachCommand}" 
                ToolTip.Tip="Detach into a standalone window"
                IsVisible="{Binding !IsDetached}">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <icons:MaterialIcon Kind="OpenInNew" Width="14" Height="14" />
            <TextBlock Text="Detach" />
          </StackPanel>
        </Button>

        <Button Classes="Small Primary" 
                Command="{Binding ReattachCommand}" 
                ToolTip.Tip="Dock console back into main window"
                IsVisible="{Binding IsDetached}">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <icons:MaterialIcon Kind="DockWindow" Width="14" Height="14" />
            <TextBlock Text="Reattach" />
          </StackPanel>
        </Button>

        <Button Classes="Small Ghost" Content="Copy" Command="{Binding CopyLogsCommand}" ToolTip.Tip="Copy visible logs" />
        <Button Classes="Small Danger Ghost" Content="Clear" Command="{Binding ClearLogsCommand}" ToolTip.Tip="Clear console logs" />
      </StackPanel>
    </Grid>

    <Border Grid.Row="1"
            Background="{DynamicResource LuminaSurfaceElevatedBrush}"
            BorderBrush="{DynamicResource LuminaBorderDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="8,6">
      <ScrollViewer Name="PART_LogScrollViewer"
                    HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding FilteredLogs}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="models:LogEntryModel">
              <Border Padding="4,2" Margin="0,1" CornerRadius="4">
                <Grid ColumnDefinitions="Auto,Auto,*">
                  <TextBlock Grid.Column="0"
                             Text="{Binding FormattedTime}"
                             FontFamily="Consolas, Cascadia Code, JetBrains Mono, monospace"
                             FontSize="11"
                             Foreground="{DynamicResource LuminaTextTertiaryBrush}"
                             VerticalAlignment="Center"
                             Margin="0,0,8,0" />

                  <Border Grid.Column="1"
                          Background="{Binding BadgeBackground}"
                          Padding="5,1"
                          CornerRadius="4"
                          VerticalAlignment="Center"
                          Margin="0,0,8,0">
                    <TextBlock Text="{Binding BadgeText}"
                               FontSize="10"
                               FontWeight="Bold"
                               Foreground="{Binding BadgeForeground}"
                               FontFamily="Consolas, monospace" />
                  </Border>

                  <SelectableTextBlock Grid.Column="2"
                                       Text="{Binding Message}"
                                       FontFamily="Consolas, Cascadia Code, JetBrains Mono, monospace"
                                       FontSize="12"
                                       Foreground="{DynamicResource LuminaTextPrimaryBrush}"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>

    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,8,0,0">
      <TextBox Text="{Binding CommandInput}"
               PlaceholderText="{Binding CommandPlaceholder}"
               FontFamily="Consolas, Cascadia Code, Courier New"
               FontSize="12">
        <TextBox.KeyBindings>
          <KeyBinding Gesture="Enter" Command="{Binding SendCommandCommand}" />
        </TextBox.KeyBindings>
      </TextBox>
      <Button Grid.Column="1" Classes="Primary Small" Content="Send" Command="{Binding SendCommandCommand}" />
    </Grid>
  </Grid>
</UserControl>