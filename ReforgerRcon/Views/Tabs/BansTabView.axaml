<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vm="using:ReforgerRcon.ViewModels"
             xmlns:models="using:ReforgerRcon.Models"
             x:Class="ReforgerRcon.Views.Tabs.BansTabView"
             x:DataType="vm:BansViewModel"
             x:Name="RootBansTab">

  <UserControl.Styles>
    <Style Selector="DataGridColumnHeader">
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="DataGridCell">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="DataGridCell:current">
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="DataGridCell:focus">
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
  </UserControl.Styles>

  <UserControl.KeyBindings>
    <KeyBinding Gesture="Ctrl+A" Command="{Binding ToggleSelectAllCommand}" />
  </UserControl.KeyBindings>

  <Grid RowDefinitions="Auto,*,Auto">
    <Border Grid.Row="0" Background="{DynamicResource LuminaSurfaceBrush}" Padding="16,8" BorderBrush="{DynamicResource LuminaBorderSubtleBrush}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Classes="Outline Small" Command="{Binding RefreshBansCommand}">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <icons:MaterialIcon Kind="Refresh" Width="14" Height="14" />
              <TextBlock Text="Refresh" />
            </StackPanel>
          </Button>

          <!-- Reforger Ban Paging Controls -->
          <Border Background="{DynamicResource LuminaNavigationPaneBrush}"
                  BorderBrush="{DynamicResource LuminaBorderSubtleBrush}"
                  BorderThickness="1"
                  CornerRadius="4"
                  Padding="6,2"
                  IsVisible="{Binding IsReforgerProtocol}"
                  VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <TextBlock Text="Paging:" Classes="Caption" VerticalAlignment="Center" FontWeight="SemiBold" />
              
              <ComboBox ItemsSource="{Binding FetchModes}" 
                        SelectedItem="{Binding SelectedFetchMode}"
                        Height="28"
                        FontSize="11.5"
                        VerticalAlignment="Center" />

              <NumericUpDown Value="{Binding CustomPageLimit}" 
                             Minimum="1" 
                             Maximum="50" 
                             FormatString="0 'pgs'"
                             Height="28" 
                             Width="90" 
                             FontSize="11.5"
                             IsVisible="{Binding IsCustomFetchMode}"
                             VerticalAlignment="Center" 
                             ToolTip.Tip="Maximum number of pages to fetch from the server (1 to 50)" />

              <!-- Clickable Help Button -->
              <Button Classes="Small Ghost Icon" 
                      Command="{Binding OpenPaginationHelpCommand}"
                      Width="26" Height="26"
                      VerticalAlignment="Center">
                <ToolTip.Tip>
                  <StackPanel Spacing="4" MaxWidth="320">
                    <TextBlock Text="Reforger Ban List Pagination (Click to read full guide)" FontWeight="Bold" FontSize="12" />
                    <TextBlock Text="The server returns 25 bans per page via '#ban list [page]'." FontSize="11" TextWrapping="Wrap" />
                    <TextBlock Text="• All Pages: Programmatically requests each page sequentially until all bans are retrieved." FontSize="11" TextWrapping="Wrap" />
                    <TextBlock Text="• First Page Only: Fetches only the first 25 bans (fastest, minimal server traffic)." FontSize="11" TextWrapping="Wrap" />
                    <TextBlock Text="• Custom Limit: Fetches sequentially up to the specified number of pages." FontSize="11" TextWrapping="Wrap" />
                  </StackPanel>
                </ToolTip.Tip>
                <icons:MaterialIcon Kind="HelpCircleOutline" 
                                   Width="16" Height="16" 
                                   Foreground="{DynamicResource LuminaPrimaryBrush}" 
                                   VerticalAlignment="Center" />
              </Button>
            </StackPanel>
          </Border>

          <Button Classes="Outline Small" 
                  Content="Load Bans" 
                  Command="{Binding LoadBansCommand}" 
                  IsVisible="{Binding IsBattlEyeProtocol}"
                  ToolTip.Tip="(Re)load the BE ban list from bans.txt in your BE working directory. Issue loadBans command after an offline/IP ban for it to take effect." />

          <Button Classes="Outline Small" 
                  Content="Write Bans" 
                  Command="{Binding WriteBansCommand}" 
                  IsVisible="{Binding IsBattlEyeProtocol}"
                  ToolTip.Tip="Re-write the current ban list to bans.txt in your BE working directory. This command can be used to remove expired bans." />

          <!-- Import Bans (.txt) Button -->
          <Button Classes="Outline Small" Command="{Binding ImportBansCommand}" ToolTip.Tip="Import bans from a .txt file">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <icons:MaterialIcon Kind="FileImportOutline" Width="14" Height="14" Foreground="{DynamicResource LuminaPrimaryBrush}" />
              <TextBlock Text="Import Bans (.txt)" />
            </StackPanel>
          </Button>

          <!-- Export Bans (.txt) Button -->
          <Button Classes="Outline Small" Command="{Binding ExportBansCommand}" ToolTip.Tip="Export current server bans to a .txt file">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <icons:MaterialIcon Kind="FileExportOutline" Width="14" Height="14" />
              <TextBlock Text="Export Bans (.txt)" />
            </StackPanel>
          </Button>
        </StackPanel>

        <ToggleButton Grid.Column="2" Classes="Outline Small" IsChecked="{Binding IsMultiSelectMode}" Content="Multi-Select" />
      </Grid>
    </Border>

    <DataGrid x:Name="BansGrid"
              Grid.Row="1"
              ItemsSource="{Binding Bans}"
              SelectedItem="{Binding SelectedBan}"
              AutoGenerateColumns="False"
              IsReadOnly="True"
              GridLinesVisibility="Horizontal"
              CanUserResizeColumns="True"
              CanUserReorderColumns="True"
              CanUserSortColumns="True"
              Sorting="OnDataGridSorting"
              SelectionMode="Single"
              Margin="0"
              x:CompileBindings="False">

      <DataGrid.KeyBindings>
        <KeyBinding Gesture="Ctrl+A" Command="{Binding ToggleSelectAllCommand}" />
      </DataGrid.KeyBindings>

      <DataGrid.ContextMenu>
        <ContextMenu>
          <MenuItem Header="Remove Ban" Command="{Binding RemoveBanCommand}" CommandParameter="{Binding SelectedBan}" />
          <Separator />
          <MenuItem Header="Copy Ban Info" Command="{Binding CopyBanInfoCommand}" CommandParameter="{Binding SelectedBan}" />
        </ContextMenu>
      </DataGrid.ContextMenu>

      <DataGrid.Columns>
        <DataGridTemplateColumn Tag="ColSelect" 
                                Width="50" 
                                MinWidth="50" 
                                MaxWidth="50" 
                                CanUserResize="False" 
                                CanUserSort="False" 
                                CanUserReorder="False"
                                IsVisible="False">
          <DataGridTemplateColumn.HeaderTemplate>
            <DataTemplate>
              <Grid Width="50" Height="36" HorizontalAlignment="Left" VerticalAlignment="Center" Background="Transparent">
                <CheckBox IsChecked="{Binding IsAllSelected, Mode=TwoWay}"
                          HorizontalAlignment="Center" 
                          VerticalAlignment="Center"
                          Margin="0" 
                          Padding="0" 
                          MinWidth="0" 
                          MinHeight="0"
                          IsThreeState="True"
                          Focusable="False"
                          Cursor="Hand"
                          ToolTip.Tip="{Binding SelectAllTooltipText}" />
              </Grid>
            </DataTemplate>
          </DataGridTemplateColumn.HeaderTemplate>
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="models:BanModel">
              <Border HorizontalAlignment="Center" VerticalAlignment="Center">
                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" 
                          HorizontalAlignment="Center" 
                          VerticalAlignment="Center" 
                          Margin="0" 
                          Padding="0" 
                          MinWidth="0" 
                          MinHeight="0" />
              </Border>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

        <DataGridTemplateColumn Tag="ColReforgerBannedName" Header="Banned Name" Width="260" MinWidth="140">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="models:BanModel">
              <TextBlock Text="{Binding BannedName}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

        <DataGridTextColumn Tag="ColReforgerIdentity" Header="Identity ID" Binding="{Binding IdentityId}" Width="*" MinWidth="220" />

        <DataGridTextColumn Tag="ColBeBanNo" Header="[#]" Binding="{Binding BanNumber}" Width="70" MinWidth="50" />

        <DataGridTextColumn Tag="ColBeIdentity" Header="GUID / IP Address" Binding="{Binding IdentityId}" Width="320" MinWidth="180" />

        <DataGridTextColumn Tag="ColBeMinutes" Header="Minutes Left" Binding="{Binding MinutesLeftText}" Width="150" MinWidth="110" />

        <DataGridTextColumn Tag="ColBeReason" Header="Reason" Binding="{Binding Reason}" Width="*" MinWidth="160" />

        <DataGridTemplateColumn Tag="ColActions" Header="Actions" Width="140" MinWidth="130">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="models:BanModel">
              <Button Classes="Small Danger Outline" Content="Remove Ban" 
                      Command="{Binding $parent[DataGrid].DataContext.RemoveBanCommand}"
                      CommandParameter="{Binding}" 
                      Margin="0,0,8,0"
                      HorizontalAlignment="Right" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
      </DataGrid.Columns>
    </DataGrid>

    <Border Grid.Row="2" Background="{DynamicResource LuminaSurfaceElevatedBrush}" Padding="16,12" 
            BorderBrush="{DynamicResource LuminaBorderDefaultBrush}" BorderThickness="0,1,0,0"
            IsVisible="{Binding IsMultiSelectMode}">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <TextBlock Text="{Binding SelectedCount, StringFormat='Selected: {0} ban(s)'}" FontWeight="Bold" VerticalAlignment="Center" />
          <Button Classes="Outline Small" Content="{Binding SelectAllButtonText}" Command="{Binding ToggleSelectAllCommand}" ToolTip.Tip="Toggle selection for all rows (Ctrl+A)" />
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10">
          <Button Classes="Outline Small" Content="Copy All Info" Command="{Binding CopyAllInfoCommand}" />
          <Button Classes="Danger Small" Content="Remove Selected Bans" Command="{Binding RemoveSelectedBansCommand}" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>