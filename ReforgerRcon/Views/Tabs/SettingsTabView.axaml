<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lumina="clr-namespace:LuminaUI.Controls;assembly=LuminaUI"
             xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vm="using:ReforgerRcon.ViewModels"
             x:Class="ReforgerRcon.Views.Tabs.SettingsTabView"
             x:DataType="vm:SettingsViewModel">

  <ScrollViewer Margin="24">
    <StackPanel Spacing="20" MaxWidth="720" HorizontalAlignment="Left">
      <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
        <TextBlock Text="Application Settings" Classes="Display" FontSize="24" />
        <Button Grid.Column="1" Classes="Primary" Content="Save Preferences" Command="{Binding SaveSettingsCommand}" />
      </Grid>

      <!-- Appearance and Window Effects Card -->
      <lumina:LuminaCard Padding="16">
        <StackPanel Spacing="14">
          <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <icons:MaterialIcon Kind="PaletteOutline" Width="20" Height="20" Foreground="{DynamicResource LuminaPrimaryBrush}" />
              <TextBlock Text="Appearance and Theme" Classes="SectionTitle" FontSize="16" />
            </StackPanel>
          </Grid>

          <!-- Theme Mode Selection -->
          <Border Background="{DynamicResource LuminaHoverBackgroundBrush}" CornerRadius="6" Padding="12,10">
            <Grid ColumnDefinitions="140,*" ColumnSpacing="12" VerticalAlignment="Center">
              <TextBlock Text="Theme Mode:" FontWeight="SemiBold" VerticalAlignment="Center" />
              <ComboBox Grid.Column="1" 
                        ItemsSource="{Binding ThemeOptions}" 
                        SelectedItem="{Binding SelectedThemeOption, Mode=TwoWay}"
                        HorizontalAlignment="Stretch"
                        ToolTip.Tip="System Default matches Windows / macOS / Linux OS dark/light mode automatically." />
            </Grid>
          </Border>

          <TextBlock Text="Control OS-level backdrop material transparency effects (Windows Mica / Acrylic blur). When disabled (default), windows render with crisp, solid, high-contrast theme backgrounds." Classes="Caption" />

          <ToggleSwitch Content="Window Glass / Blur Backdrop Effect (Mica / Acrylic)" 
                        IsChecked="{Binding Settings.EnableWindowGlass}"
                        ToolTip.Tip="Toggle between OS-level acrylic glass blur and solid theme backgrounds." />
        </StackPanel>
      </lumina:LuminaCard>

      <!-- Notification Channels Card -->
      <lumina:LuminaCard Padding="16">
        <StackPanel Spacing="14">
          <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <icons:MaterialIcon Kind="BellRingOutline" Width="20" Height="20" Foreground="{DynamicResource LuminaPrimaryBrush}" />
              <TextBlock Text="Notification Channels" Classes="SectionTitle" FontSize="16" />
            </StackPanel>
          </Grid>

          <TextBlock Text="Configure delivery mechanisms for real-time alerts. Custom audio files placed in Assets/audio/ (join.mp3/wav, leave.mp3/wav, watchlist.mp3/wav, warning.mp3/wav, error.mp3/wav) will play automatically." Classes="Caption" />

          <!-- Audio Alerts Toggle and Test Button -->
          <Border Background="{DynamicResource LuminaHoverBackgroundBrush}" CornerRadius="6" Padding="12,8">
            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
              <ToggleSwitch Grid.Column="0" 
                            Content="Audio Alerts (Custom Sound Assets / System Beeps)" 
                            IsChecked="{Binding Settings.AudioAlerts}" 
                            VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                <Button Classes="Small Outline" Command="{Binding TestAudioAlertCommand}" CommandParameter="Join" ToolTip.Tip="Test Join sound">
                  <StackPanel Orientation="Horizontal" Spacing="4">
                    <icons:MaterialIcon Kind="VolumeHigh" Width="14" Height="14" />
                    <TextBlock Text="Test Sound" />
                  </StackPanel>
                </Button>
              </StackPanel>
            </Grid>
          </Border>

          <!-- In-App Toast Notifications Toggle -->
          <Border Background="{DynamicResource LuminaHoverBackgroundBrush}" CornerRadius="6" Padding="12,8">
            <ToggleSwitch Content="Toast Notifications (Action commands, execution history, and Undo)" 
                          IsChecked="{Binding Settings.ToastNotifications}" />
          </Border>

          <!-- Native OS Push Notifications Toggle and Test Button -->
          <Border Background="{DynamicResource LuminaHoverBackgroundBrush}" CornerRadius="6" Padding="12,8">
            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
              <ToggleSwitch Grid.Column="0" 
                            Content="Native OS Push Notifications (Windows Action Center / macOS / Linux)" 
                            IsChecked="{Binding Settings.PushNotifications}" 
                            VerticalAlignment="Center" />
              <Button Grid.Column="1" Classes="Small Outline" Command="{Binding TestPushNotificationCommand}" ToolTip.Tip="Send test push notification to OS tray">
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <icons:MaterialIcon Kind="SendOutline" Width="14" Height="14" />
                  <TextBlock Text="Test Push" />
                </StackPanel>
              </Button>
            </Grid>
          </Border>
        </StackPanel>
      </lumina:LuminaCard>

      <!-- Alert Triggers and Events Card -->
      <lumina:LuminaCard Padding="16">
        <StackPanel Spacing="12">
          <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <icons:MaterialIcon Kind="AlarmLightOutline" Width="20" Height="20" Foreground="{DynamicResource LuminaPrimaryBrush}" />
              <TextBlock Text="Alert Event Triggers" Classes="SectionTitle" FontSize="16" />
            </StackPanel>
          </Grid>

          <TextBlock Text="Select which server events should dispatch alerts through your active notification channels." Classes="Caption" />

          <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="*,*" RowSpacing="8" ColumnSpacing="16" Margin="0,4,0,0">
            <CheckBox Grid.Row="0" Grid.Column="0" 
                      Content="Player Joins Server" 
                      IsChecked="{Binding Settings.AlertOnJoin}" />

            <CheckBox Grid.Row="0" Grid.Column="1" 
                      Content="Player Leaves Server" 
                      IsChecked="{Binding Settings.AlertOnLeave}" />

            <CheckBox Grid.Row="1" Grid.Column="0" 
                      Content="Watchlisted Player Joins Server" 
                      IsChecked="{Binding Settings.AlertOnWatchlistJoin}" />

            <CheckBox Grid.Row="1" Grid.Column="1" 
                      Content="Watchlisted Player Leaves Server" 
                      IsChecked="{Binding Settings.AlertOnWatchlistLeave}" />
          </Grid>
        </StackPanel>
      </lumina:LuminaCard>

      <!-- Privacy and Diagnostic Telemetry Card -->
      <lumina:LuminaCard Padding="16">
        <StackPanel Spacing="12">
          <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <icons:MaterialIcon Kind="ShieldLockOutline" Width="20" Height="20" Foreground="{DynamicResource LuminaPrimaryBrush}" />
              <TextBlock Text="Privacy and Telemetry" Classes="SectionTitle" FontSize="16" />
            </StackPanel>
          </Grid>

          <TextBlock Text="Help improve ARRT with privacy-first anonymous analytics and crash reports. All passwords, server IP addresses, and user-identifiables are strictly redacted. Disabled by default." Classes="Caption" />

          <ToggleSwitch Content="Send anonymous diagnostic and crash reports" 
                        IsChecked="{Binding Settings.SendAnonymousCrashReports}"
                        ToolTip.Tip="Disabled by default. When enabled, logs, crash dumps, and performance metrics are sent anonymously. All passwords and server credentials are scrubbed." />

          <!-- Persistent Anonymous Installation ID Box -->
          <Border Background="{DynamicResource LuminaHoverBackgroundBrush}" CornerRadius="6" Padding="12,8">
            <Grid ColumnDefinitions="140,*,Auto" ColumnSpacing="10" VerticalAlignment="Center">
              <TextBlock Grid.Column="0" Text="Anonymous User ID:" Classes="Caption" FontWeight="SemiBold" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="{Binding InstallationId}" FontFamily="Consolas, monospace" FontSize="12" Foreground="{DynamicResource LuminaTextSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
              <Button Grid.Column="2" Classes="Small Ghost Icon" Command="{Binding CopyInstallationIdCommand}" ToolTip.Tip="Copy Anonymous Installation ID">
                <icons:MaterialIcon Kind="ContentCopy" Width="14" Height="14" />
              </Button>
            </Grid>
          </Border>
        </StackPanel>
      </lumina:LuminaCard>

      <!-- Table Display and Default Sorting Card -->
      <lumina:LuminaCard Padding="16">
        <StackPanel Spacing="14">
          <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <icons:MaterialIcon Kind="SortVariant" Width="20" Height="20" Foreground="{DynamicResource LuminaPrimaryBrush}" />
              <TextBlock Text="Table Display and Default Sorting" Classes="SectionTitle" FontSize="16" />
            </StackPanel>
          </Grid>

          <TextBlock Text="Configure independent default sorting fields and order for each tab. 'Default' preserves the raw order as received directly from the server or database." Classes="Caption" />

          <!-- 1. Players Tab Sorting -->
          <Border Background="{DynamicResource LuminaHoverBackgroundBrush}" CornerRadius="6" Padding="12,10">
            <Grid ColumnDefinitions="140,*,140" ColumnSpacing="12" VerticalAlignment="Center">
              <TextBlock Text="Players Tab:" FontWeight="SemiBold" VerticalAlignment="Center" />
              <ComboBox Grid.Column="1" 
                        ItemsSource="{Binding PlayersSortOptions}" 
                        SelectedItem="{Binding Settings.PlayersSortBy}"
                        HorizontalAlignment="Stretch"
                        ToolTip.Tip="Default shows the player list in the order received directly from the server." />
              <ToggleSwitch Grid.Column="2" 
                            OnContent="Ascending" 
                            OffContent="Descending" 
                            IsChecked="{Binding Settings.PlayersSortAscending}" 
                            HorizontalAlignment="Right" />
            </Grid>
          </Border>

          <!-- 2. Bans Tab Sorting -->
          <Border Background="{DynamicResource LuminaHoverBackgroundBrush}" CornerRadius="6" Padding="12,10">
            <Grid ColumnDefinitions="140,*,140" ColumnSpacing="12" VerticalAlignment="Center">
              <TextBlock Text="Bans Tab:" FontWeight="SemiBold" VerticalAlignment="Center" />
              <ComboBox Grid.Column="1" 
                        ItemsSource="{Binding BansSortOptions}" 
                        SelectedItem="{Binding Settings.BansSortBy}"
                        HorizontalAlignment="Stretch"
                        ToolTip.Tip="Default shows the ban list in the order received directly from the server." />
              <ToggleSwitch Grid.Column="2" 
                            OnContent="Ascending" 
                            OffContent="Descending" 
                            IsChecked="{Binding Settings.BansSortAscending}" 
                            HorizontalAlignment="Right" />
            </Grid>
          </Border>

          <!-- 3. Players Database Tab Sorting -->
          <Border Background="{DynamicResource LuminaHoverBackgroundBrush}" CornerRadius="6" Padding="12,10">
            <Grid ColumnDefinitions="140,*,140" ColumnSpacing="12" VerticalAlignment="Center">
              <TextBlock Text="Players Database:" FontWeight="SemiBold" VerticalAlignment="Center" />
              <ComboBox Grid.Column="1" 
                        ItemsSource="{Binding DatabaseSortOptions}" 
                        SelectedItem="{Binding Settings.DatabaseSortBy}"
                        HorizontalAlignment="Stretch"
                        ToolTip.Tip="Default shows the historical player database in the order retrieved from the database (Last Seen)." />
              <ToggleSwitch Grid.Column="2" 
                            OnContent="Ascending" 
                            OffContent="Descending" 
                            IsChecked="{Binding Settings.DatabaseSortAscending}" 
                            HorizontalAlignment="Right" />
            </Grid>
          </Border>
        </StackPanel>
      </lumina:LuminaCard>

      <!-- SQLite Database Storage Details Card -->
      <lumina:LuminaCard Padding="16">
        <StackPanel Spacing="14">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <icons:MaterialIcon Kind="Database" Width="20" Height="20" Foreground="{DynamicResource LuminaPrimaryBrush}" />
              <TextBlock Text="SQLite Historical Database Engine" Classes="SectionTitle" FontSize="16" />
            </StackPanel>
            <Button Grid.Column="1" Classes="Small Outline" Content="Refresh Stats" Command="{Binding RefreshDatabaseStatsCommand}" />
          </Grid>

          <TextBlock Text="Player data, session history, and alias tracking are stored in a high-performance, WAL-enabled relational SQLite database." Classes="Caption" />

          <Border Background="{DynamicResource LuminaHoverBackgroundBrush}" CornerRadius="6" Padding="12,8">
            <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="170,*" RowSpacing="6">
              <TextBlock Grid.Row="0" Grid.Column="0" Text="Database Engine:" Classes="Caption" FontWeight="SemiBold" />
              <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding DatabaseEngineText}" FontWeight="SemiBold" Foreground="{DynamicResource LuminaSuccessBrush}" />

              <TextBlock Grid.Row="1" Grid.Column="0" Text="Stored Player Records:" Classes="Caption" FontWeight="SemiBold" />
              <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DatabaseRecordsText}" />

              <TextBlock Grid.Row="2" Grid.Column="0" Text="On-Disk Database Size:" Classes="Caption" FontWeight="SemiBold" />
              <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DatabaseSizeText}" />
            </Grid>
          </Border>

          <Button Classes="Danger Outline" Content="Purge Historical Database" Command="{Binding ClearDatabaseCommand}" HorizontalAlignment="Left" />
        </StackPanel>
      </lumina:LuminaCard>

      <!-- MaxMind GeoIP2 Configuration Card -->
      <lumina:LuminaCard Padding="16">
        <StackPanel Spacing="14">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <icons:MaterialIcon Kind="Earth" Width="20" Height="20" Foreground="{DynamicResource LuminaPrimaryBrush}" />
              <TextBlock Text="MaxMind GeoLite2 Geolocation" Classes="SectionTitle" FontSize="16" />
            </StackPanel>

            <Button Grid.Column="1" Classes="Primary Small" 
                    Content="Update Databases" 
                    Command="{Binding UpdateGeoIpDatabasesCommand}"
                    lumina:LuminaButton.IsLoading="{Binding IsGeoIpUpdating}"
                    ToolTip.Tip="Download latest binary MMDB updates from MaxMind (Requires Account ID and License Key)" />
          </Grid>

          <TextBlock Text="The app uses offline pre-bundled GeoLite2 binary databases out of the box. MaxMind credentials are only required if you wish to download newer weekly updates." Classes="Caption" />

          <!-- Optional Account ID and License Key Form -->
          <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
            <StackPanel Grid.Column="0" Spacing="4">
              <TextBlock Text="MaxMind Account ID (Optional for updates)" Classes="Label" />
              <TextBox Text="{Binding Settings.MaxMindAccountId}" PlaceholderText="Enter Account ID (e.g. 123456)" />
            </StackPanel>

            <StackPanel Grid.Column="1" Spacing="4">
              <TextBlock Text="MaxMind License Key (Optional for updates)" Classes="Label" />
              <TextBox Text="{Binding Settings.MaxMindLicenseKey}" 
                       PasswordChar="{Binding LicenseKeyMaskChar}"
                       PlaceholderText="Enter License Key...">
                <TextBox.InnerRightContent>
                  <Button Classes="Ghost Icon" 
                          Command="{Binding ToggleLicenseKeyRevealCommand}" 
                          Margin="0,0,4,0" 
                          Width="28" Height="28"
                          ToolTip.Tip="Show / Hide Key">
                    <icons:MaterialIcon Kind="{Binding LicenseKeyIconKind}" Width="14" Height="14" Foreground="{DynamicResource LuminaTextSecondaryBrush}" />
                  </Button>
                </TextBox.InnerRightContent>
              </TextBox>
            </StackPanel>
          </Grid>

          <!-- Database Status Details Box -->
          <Border Background="{DynamicResource LuminaHoverBackgroundBrush}" CornerRadius="6" Padding="12,8">
            <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="170,*" RowSpacing="6">
              <TextBlock Grid.Row="0" Grid.Column="0" Text="City Database (.mmdb):" Classes="Caption" FontWeight="SemiBold" />
              <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding GeoIpCityStatusText}" />

              <TextBlock Grid.Row="1" Grid.Column="0" Text="Country Database (.mmdb):" Classes="Caption" FontWeight="SemiBold" />
              <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding GeoIpCountryStatusText}" />

              <TextBlock Grid.Row="2" Grid.Column="0" Text="Database Version / Date:" Classes="Caption" FontWeight="SemiBold" />
              <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding GeoIpLastUpdatedText}" />
            </Grid>
          </Border>
        </StackPanel>
      </lumina:LuminaCard>

      <!-- General Settings -->
      <lumina:LuminaCard Padding="16">
        <StackPanel Spacing="14">
          <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <icons:MaterialIcon Kind="CogOutline" Width="20" Height="20" Foreground="{DynamicResource LuminaPrimaryBrush}" />
              <TextBlock Text="General and Background Execution" Classes="SectionTitle" FontSize="16" />
            </StackPanel>
          </Grid>

          <Grid ColumnDefinitions="*,120">
            <TextBlock Text="Auto-refresh Interval (Seconds)" VerticalAlignment="Center" />
            <NumericUpDown Grid.Column="1" Minimum="1" Maximum="60" Value="{Binding Settings.RefreshIntervalSeconds}" />
          </Grid>
          
          <ToggleSwitch Content="Include Ban list query in scheduled Auto-refresh" 
                        IsChecked="{Binding Settings.AutoRefreshBans}"
                        ToolTip.Tip="When enabled, the server ban list is queried alongside players on every refresh tick. Disable to reduce server RCON command traffic." />

          <ToggleSwitch Content="Keep App Running in Background while connected" IsChecked="{Binding Settings.RunInBackground}" />
        </StackPanel>
      </lumina:LuminaCard>
    </StackPanel>
  </ScrollViewer>
</UserControl>