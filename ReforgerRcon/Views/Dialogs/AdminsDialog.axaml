<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lumina="clr-namespace:LuminaUI.Controls;assembly=LuminaUI"
             xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vm="using:ReforgerRcon.ViewModels"
             xmlns:models="using:ReforgerRcon.Models"
             x:Class="ReforgerRcon.Views.Dialogs.AdminsDialog"
             x:DataType="vm:AdminsDialogViewModel">

  <lumina:LuminaCard Padding="24" Width="580" MaxHeight="660" Classes="Elevated">
    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="16">

      <!-- Dialog Header -->
      <Grid Grid.Row="0" ColumnDefinitions="*,Auto" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <Border Background="{DynamicResource LuminaPrimaryBgBrush}" CornerRadius="8" Padding="8" VerticalAlignment="Center">
            <icons:MaterialIcon Kind="AccountSupervisor" Width="22" Height="22" Foreground="{DynamicResource LuminaPrimaryBrush}" />
          </Border>
          <StackPanel Spacing="2" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <TextBlock Text="Connected RCON Admins" Classes="SectionTitle" FontSize="18" FontWeight="Bold" />
              <Border Background="{DynamicResource LuminaPrimaryBgBrush}" 
                      BorderBrush="{DynamicResource LuminaPrimaryBrush}" 
                      BorderThickness="1" 
                      CornerRadius="10" 
                      Padding="8,2" 
                      VerticalAlignment="Center">
                <TextBlock Text="{Binding AdminsCount, StringFormat='{}{0} Active'}" 
                           FontSize="11" 
                           FontWeight="Bold" 
                           Foreground="{DynamicResource LuminaPrimaryBrush}" />
              </Border>
            </StackPanel>
            <TextBlock Text="Active administrative sessions authenticated via BattlEye RCON" FontSize="12" Foreground="{DynamicResource LuminaTextSecondaryBrush}" />
          </StackPanel>
        </StackPanel>

        <Button Grid.Column="1" Classes="Ghost Icon" Content="✕" Command="{Binding CloseCommand}" ToolTip.Tip="Close" VerticalAlignment="Center" />
      </Grid>

      <!-- Main Content Area -->
      <Border Grid.Row="1" 
              Background="{DynamicResource LuminaNavigationPaneBrush}" 
              BorderBrush="{DynamicResource LuminaBorderSubtleBrush}"
              BorderThickness="1"
              CornerRadius="8" 
              Padding="10"
              MinHeight="200">
        <Grid>
          <!-- 1. Active Admins List -->
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding !IsEmpty}">
            <ItemsControl ItemsSource="{Binding Admins}" x:CompileBindings="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="models:AdminModel">
                  <Border Background="{DynamicResource LuminaSurfaceBrush}" 
                          BorderBrush="{DynamicResource LuminaBorderSubtleBrush}" 
                          BorderThickness="1" 
                          CornerRadius="6" 
                          Padding="14,12" 
                          Margin="0,0,0,8">

                    <!-- Right-Click Context Menu -->
                    <Border.ContextMenu>
                      <ContextMenu x:CompileBindings="False">
                        <MenuItem Header="Copy Endpoint (IP:Port)" 
                                  Command="{Binding $parent[ItemsControl].DataContext.CopyEndpointCommand}" 
                                  CommandParameter="{Binding}">
                          <MenuItem.Icon>
                            <icons:MaterialIcon Kind="ServerNetwork" Width="16" Height="16" Foreground="{DynamicResource LuminaPrimaryBrush}" />
                          </MenuItem.Icon>
                        </MenuItem>

                        <MenuItem Header="Copy IP Address Only" 
                                  Command="{Binding $parent[ItemsControl].DataContext.CopyIpOnlyCommand}" 
                                  CommandParameter="{Binding}">
                          <MenuItem.Icon>
                            <icons:MaterialIcon Kind="IpNetworkOutline" Width="16" Height="16" Foreground="{DynamicResource LuminaPrimaryBrush}" />
                          </MenuItem.Icon>
                        </MenuItem>

                        <Separator />

                        <MenuItem Header="Copy Full Diagnostic Info" 
                                  Command="{Binding $parent[ItemsControl].DataContext.CopyFullInfoCommand}" 
                                  CommandParameter="{Binding}">
                          <MenuItem.Icon>
                            <icons:MaterialIcon Kind="ContentCopy" Width="16" Height="16" Foreground="{DynamicResource LuminaPrimaryBrush}" />
                          </MenuItem.Icon>
                        </MenuItem>
                      </ContextMenu>
                    </Border.ContextMenu>

                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" VerticalAlignment="Center">
                      <!-- Admin ID & You Badge -->
                      <StackPanel Spacing="4" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Border Background="{DynamicResource LuminaPrimaryBgBrush}" 
                                BorderBrush="{DynamicResource LuminaPrimaryBrush}" 
                                BorderThickness="1" 
                                Padding="8,3" 
                                CornerRadius="4" 
                                HorizontalAlignment="Center">
                          <TextBlock Text="{Binding Id, StringFormat='#{0}'}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource LuminaPrimaryBrush}" />
                        </Border>

                        <Border Background="{DynamicResource LuminaSuccessBgBrush}" 
                                BorderBrush="{DynamicResource LuminaSuccessBrush}" 
                                BorderThickness="1" 
                                Padding="4,1" 
                                CornerRadius="3"
                                IsVisible="{Binding IsCurrentSession}"
                                HorizontalAlignment="Center"
                                ToolTip.Tip="This is your active connected RCON session">
                          <TextBlock Text="YOU" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource LuminaSuccessBrush}" />
                        </Border>
                      </StackPanel>

                      <!-- Center Details -->
                      <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                        <!-- Endpoint & Status -->
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                          <Border CornerRadius="3" ClipToBounds="True" BoxShadow="0 1 3 #30000000" VerticalAlignment="Center">
                            <Image Source="{Binding Country.FlagImage}" Width="32" Height="22" Stretch="Uniform" />
                          </Border>

                          <TextBlock Text="{Binding FormattedEndpoint}" 
                                     FontFamily="Consolas, Cascadia Code, monospace" 
                                     FontWeight="Bold" 
                                     FontSize="13.5" 
                                     Foreground="{DynamicResource LuminaTextPrimaryBrush}" 
                                     VerticalAlignment="Center" />

                          <Border Width="7" Height="7" CornerRadius="3.5" Background="{DynamicResource LuminaSuccessBrush}" VerticalAlignment="Center" ToolTip.Tip="Active Socket Connection" />
                        </StackPanel>

                        <!-- Location & Time -->
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" Margin="0,2,0,0">
                          <TextBlock Grid.Column="0" Text="{Binding Location}" Classes="Caption" FontSize="11.5" Foreground="{DynamicResource LuminaTextSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                          
                          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <icons:MaterialIcon Kind="ClockOutline" Width="13" Height="13" Foreground="{DynamicResource LuminaPrimaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding FormattedLocalTime}" FontSize="11" Foreground="{DynamicResource LuminaTextTertiaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                        </Grid>
                      </StackPanel>

                      <!-- Quick Action Button -->
                      <Button Grid.Column="2" 
                              Classes="Small Ghost Icon" 
                              Command="{Binding $parent[ItemsControl].DataContext.CopyFullInfoCommand}" 
                              CommandParameter="{Binding}"
                              ToolTip.Tip="Copy Full Admin Details"
                              VerticalAlignment="Center">
                        <icons:MaterialIcon Kind="ContentCopy" Width="15" Height="15" Foreground="{DynamicResource LuminaTextSecondaryBrush}" />
                      </Button>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>

          <!-- 2. Empty State View -->
          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8" IsVisible="{Binding IsEmpty}">
            <icons:MaterialIcon Kind="ShieldOffOutline" Width="42" Height="42" Foreground="{DynamicResource LuminaTextTertiaryBrush}" HorizontalAlignment="Center" />
            <TextBlock Text="No Connected RCON Admins" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" />
            <TextBlock Text="No active administrator sessions were returned by the server." Classes="Caption" FontSize="11" HorizontalAlignment="Center" />
          </StackPanel>

          <!-- 3. Loading Indicator Overlay -->
          <Border Background="#60000000" CornerRadius="8" IsVisible="{Binding IsLoading}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10">
              <ProgressBar IsIndeterminate="True" Width="160" Height="6" CornerRadius="3" />
              <TextBlock Text="Querying connected RCON admins..." Classes="Caption" FontSize="12" Foreground="White" HorizontalAlignment="Center" />
            </StackPanel>
          </Border>
        </Grid>
      </Border>

      <!-- Footer Buttons Strip -->
      <Grid Grid.Row="2" ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="8">
        <Button Grid.Column="0" Classes="Outline Small" Command="{Binding LoadAdminsCommand}" lumina:LuminaButton.IsLoading="{Binding IsLoading}">
          <StackPanel Orientation="Horizontal" Spacing="5">
            <icons:MaterialIcon Kind="Refresh" Width="14" Height="14" />
            <TextBlock Text="Refresh Admins" />
          </StackPanel>
        </Button>

        <Button Grid.Column="1" Classes="Outline Small" Command="{Binding CopyAllAdminsCommand}" ToolTip.Tip="Copy all connected admin endpoints for audit logging">
          <StackPanel Orientation="Horizontal" Spacing="5">
            <icons:MaterialIcon Kind="ContentCopy" Width="14" Height="14" />
            <TextBlock Text="Copy All Admins" />
          </StackPanel>
        </Button>

        <Button Grid.Column="3" Classes="Primary Small" Content="Close" Command="{Binding CloseCommand}" MinWidth="90" HorizontalContentAlignment="Center" />
      </Grid>
    </Grid>
  </lumina:LuminaCard>
</UserControl>