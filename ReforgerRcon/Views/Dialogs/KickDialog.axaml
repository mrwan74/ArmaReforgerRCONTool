<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lumina="clr-namespace:LuminaUI.Controls;assembly=LuminaUI"
             xmlns:vm="using:ReforgerRcon.ViewModels"
             x:Class="ReforgerRcon.Views.Dialogs.KickDialog"
             x:DataType="vm:KickDialogViewModel">

  <lumina:LuminaCard Padding="24" Width="440" Classes="Elevated">
    <StackPanel Spacing="16">
      <TextBlock Text="Kick Confirmation" Classes="SectionTitle" FontSize="20" />
      <TextBlock Text="{Binding TargetNames, StringFormat='Are you sure you want to kick: {0}?'}" TextWrapping="Wrap" />

      <StackPanel Spacing="4">
        <TextBlock Text="Reason" Classes="Label" />
        <TextBox Text="{Binding Reason}" />
      </StackPanel>

      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10" Margin="0,8,0,0">
        <Button Grid.Column="1" Classes="Outline" Content="Cancel" Command="{Binding CloseCommand}" />
        <Button Grid.Column="2" Classes="Danger" Content="Confirm Kick" Command="{Binding ConfirmKickCommand}" />
      </Grid>
    </StackPanel>
  </lumina:LuminaCard>
</UserControl>
