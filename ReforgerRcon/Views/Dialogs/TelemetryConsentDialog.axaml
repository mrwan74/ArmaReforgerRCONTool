<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lumina="clr-namespace:LuminaUI.Controls;assembly=LuminaUI"
             xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vm="using:ReforgerRcon.ViewModels"
             x:Class="ReforgerRcon.Views.Dialogs.TelemetryConsentDialog"
             x:DataType="vm:TelemetryConsentDialogViewModel">

  <lumina:LuminaCard Padding="26" Width="520" Classes="Elevated" HorizontalAlignment="Center" VerticalAlignment="Center">
    <StackPanel Spacing="16">
      
      <!-- Header with Shield Icon & Title in separate columns -->
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14" VerticalAlignment="Center">
        <Border Grid.Column="0" 
                Background="{DynamicResource LuminaPrimaryBgBrush}" 
                CornerRadius="8" 
                Padding="10" 
                VerticalAlignment="Center">
          <icons:MaterialIcon Kind="ShieldLockOutline" 
                             Foreground="{DynamicResource LuminaPrimaryBrush}" 
                             Width="24" Height="24" />
        </Border>

        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
          <TextBlock Text="Anonymous Diagnostics &amp; Crash Reports" 
                     Classes="SectionTitle" 
                     FontSize="17" 
                     FontWeight="Bold" 
                     TextWrapping="Wrap" />
          <TextBlock Text="Help us improve ARMA Reforger RCON Tool" 
                     FontSize="12" 
                     Foreground="{DynamicResource LuminaTextSecondaryBrush}" />
        </StackPanel>
      </Grid>

      <!-- Explanation Box -->
      <Border Background="{DynamicResource LuminaHoverBackgroundBrush}" 
              CornerRadius="6" 
              Padding="14,12">
        <StackPanel Spacing="10">
          <TextBlock Text="Would you like to help improve ARRT by automatically sending anonymous diagnostic crash reports and performance metrics?" 
                     FontSize="12.5" 
                     TextWrapping="Wrap" 
                     LineHeight="18" 
                     Foreground="{DynamicResource LuminaTextPrimaryBrush}" />

          <StackPanel Spacing="6">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" VerticalAlignment="Center">
              <icons:MaterialIcon Grid.Column="0" Kind="CheckCircleOutline" Width="15" Height="15" Foreground="{DynamicResource LuminaSuccessBrush}" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="All passwords are redacted." FontSize="11.5" Foreground="{DynamicResource LuminaTextSecondaryBrush}" VerticalAlignment="Center" />
            </Grid>

            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" VerticalAlignment="Center">
              <icons:MaterialIcon Grid.Column="0" Kind="CheckCircleOutline" Width="15" Height="15" Foreground="{DynamicResource LuminaSuccessBrush}" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="No personal identification or IP addresses are collected." FontSize="11.5" Foreground="{DynamicResource LuminaTextSecondaryBrush}" VerticalAlignment="Center" />
            </Grid>

            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" VerticalAlignment="Center">
              <icons:MaterialIcon Grid.Column="0" Kind="CheckCircleOutline" Width="15" Height="15" Foreground="{DynamicResource LuminaSuccessBrush}" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="You can change this preference anytime in the Settings tab." FontSize="11.5" Foreground="{DynamicResource LuminaTextSecondaryBrush}" VerticalAlignment="Center" />
            </Grid>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Action Buttons -->
      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10" Margin="0,4,0,0">
        <Button Grid.Column="1" 
                Classes="Outline" 
                Content="Keep Disabled" 
                Command="{Binding DeclineCommand}" 
                MinWidth="120"
                HorizontalContentAlignment="Center" />

        <Button Grid.Column="2" 
                Classes="Primary" 
                Content="Enable Anonymous Reporting" 
                Command="{Binding EnableCommand}" 
                MinWidth="190"
                HorizontalContentAlignment="Center" />
      </Grid>
    </StackPanel>
  </lumina:LuminaCard>
</UserControl>