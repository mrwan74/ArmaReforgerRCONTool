<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lumina="clr-namespace:LuminaUI.Controls;assembly=LuminaUI"
             xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vm="using:ReforgerRcon.ViewModels"
             x:Class="ReforgerRcon.Views.Dialogs.PlayerDetailDialog"
             x:DataType="vm:PlayerDetailViewModel">

  <lumina:LuminaCard Padding="24" Width="540" MaxHeight="680" Classes="Elevated">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Spacing="16">
        <!-- Dialog Header -->
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Spacing="2">
            <TextBlock Text="Player Details" Classes="SectionTitle" FontSize="20" />
            <TextBlock Text="{Binding Player.Name}" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource LuminaTextSecondaryBrush}" />
          </StackPanel>
          <Button Grid.Column="1" Classes="Ghost Icon" Content="✕" Command="{Binding CloseCommand}" />
        </Grid>

        <!-- Warning Banner if Name Changed / Aliases Exist -->
        <Border Background="{DynamicResource LuminaWarningBgBrush}" 
                BorderBrush="{DynamicResource LuminaWarningBrush}" 
                BorderThickness="1" CornerRadius="6" Padding="10"
                IsVisible="{Binding Player.HasAliases}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <icons:MaterialIcon Kind="Alert" Foreground="{DynamicResource LuminaWarningBrush}" Width="18" Height="18"/>
            <TextBlock Text="Warning: Player has known name changes/aliases!" Foreground="{DynamicResource LuminaWarningBrush}" VerticalAlignment="Center" />
          </StackPanel>
        </Border>

        <!-- Reforger Protocol Details Format -->
        <StackPanel Spacing="12" IsVisible="{Binding IsReforgerProtocol}">
          <Grid ColumnDefinitions="110,*,Auto" ColumnSpacing="8" VerticalAlignment="Center">
            <TextBlock Text="Status:" Classes="Caption" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <Border Width="8" Height="8" CornerRadius="4" Background="{DynamicResource LuminaSuccessBrush}" />
              <TextBlock Text="Online" FontWeight="SemiBold" />
              <TextBlock Text="(Watchlisted)" Foreground="{DynamicResource LuminaWarningBrush}" IsVisible="{Binding Player.IsWatchlisted}" Margin="4,0,0,0"/>
            </StackPanel>
          </Grid>

          <Grid ColumnDefinitions="110,*,Auto" ColumnSpacing="8" VerticalAlignment="Center">
            <TextBlock Text="Player#:" Classes="Caption" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding Player.Id}" VerticalAlignment="Center" />
            <Button Grid.Column="2" Classes="Ghost Icon" Command="{Binding CopyFieldCommand}" CommandParameter="{Binding Player.Id}" ToolTip.Tip="Copy Player#">
              <icons:MaterialIcon Kind="ContentCopy" Width="14" Height="14" />
            </Button>
          </Grid>

          <Grid ColumnDefinitions="110,*,Auto" ColumnSpacing="8" VerticalAlignment="Center">
            <TextBlock Text="Player Name:" Classes="Caption" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding Player.Name}" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
            <Button Grid.Column="2" Classes="Ghost Icon" Command="{Binding CopyFieldCommand}" CommandParameter="{Binding Player.Name}" ToolTip.Tip="Copy Name">
              <icons:MaterialIcon Kind="ContentCopy" Width="14" Height="14" />
            </Button>
          </Grid>

          <Grid ColumnDefinitions="110,*,Auto" ColumnSpacing="8" VerticalAlignment="Center">
            <TextBlock Text="Player UID:" Classes="Caption" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding Player.Uid}" VerticalAlignment="Center" TextWrapping="Wrap" FontFamily="Consolas, monospace" FontSize="12" />
            <Button Grid.Column="2" Classes="Ghost Icon" Command="{Binding CopyFieldCommand}" CommandParameter="{Binding Player.Uid}" ToolTip.Tip="Copy UID">
              <icons:MaterialIcon Kind="ContentCopy" Width="14" Height="14" />
            </Button>
          </Grid>

          <Grid ColumnDefinitions="110,*,Auto" ColumnSpacing="8" VerticalAlignment="Center">
            <TextBlock Text="Comment:" Classes="Caption" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding Player.Comment}" VerticalAlignment="Center" TextWrapping="Wrap" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
              <Button Classes="Ghost Icon" Command="{Binding EditCommentCommand}" ToolTip.Tip="Edit Comment">
                <icons:MaterialIcon Kind="PencilOutline" Width="14" Height="14" />
              </Button>
              <Button Classes="Ghost Icon" Command="{Binding CopyFieldCommand}" CommandParameter="{Binding Player.Comment}" ToolTip.Tip="Copy Comment">
                <icons:MaterialIcon Kind="ContentCopy" Width="14" Height="14" />
              </Button>
            </StackPanel>
          </Grid>
        </StackPanel>

        <!-- BattlEye Protocol Details Format -->
        <StackPanel Spacing="12" IsVisible="{Binding IsBattlEyeProtocol}">
          <Grid ColumnDefinitions="110,*,Auto" ColumnSpacing="8" VerticalAlignment="Center">
            <TextBlock Text="Status:" Classes="Caption" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <Border Width="8" Height="8" CornerRadius="4" Background="{DynamicResource LuminaSuccessBrush}" />
              <TextBlock Text="Online" FontWeight="SemiBold" />
              <TextBlock Text="(Watchlisted)" Foreground="{DynamicResource LuminaWarningBrush}" IsVisible="{Binding Player.IsWatchlisted}" Margin="4,0,0,0"/>
            </StackPanel>
          </Grid>

          <Grid ColumnDefinitions="110,*,Auto" ColumnSpacing="8" VerticalAlignment="Center">
            <TextBlock Text="[#]:" Classes="Caption" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding Player.Id}" VerticalAlignment="Center" />
            <Button Grid.Column="2" Classes="Ghost Icon" Command="{Binding CopyFieldCommand}" CommandParameter="{Binding Player.Id}" ToolTip.Tip="Copy [#]">
              <icons:MaterialIcon Kind="ContentCopy" Width="14" Height="14" />
            </Button>
          </Grid>

          <!-- Country with Flag + Natural Location (Zero-Overlap Grid Layout) -->
          <Grid ColumnDefinitions="110,Auto,*,Auto" ColumnSpacing="8" VerticalAlignment="Center">
            <TextBlock Grid.Column="0" Text="Location:" Classes="Caption" VerticalAlignment="Center" />
            
            <Border Grid.Column="1" CornerRadius="3" ClipToBounds="True" BoxShadow="0 1 3 #30000000" VerticalAlignment="Center">
              <Image Source="{Binding Player.Country.FlagImage}" Width="36" Height="25" Stretch="Uniform" />
            </Border>
            
            <TextBlock Grid.Column="2" 
                       Text="{Binding Player.DisplayLocation}" 
                       VerticalAlignment="Center" 
                       TextWrapping="Wrap"
                       Margin="2,0,4,0" />
                       
            <Button Grid.Column="3" Classes="Ghost Icon" 
                    Command="{Binding CopyFieldCommand}" 
                    CommandParameter="{Binding Player.DisplayLocation}" 
                    ToolTip.Tip="Copy Location"
                    VerticalAlignment="Center">
              <icons:MaterialIcon Kind="ContentCopy" Width="14" Height="14" />
            </Button>
          </Grid>

          <!-- Current Local Time with Clock Icon -->
          <Grid ColumnDefinitions="110,Auto,*,Auto" ColumnSpacing="8" VerticalAlignment="Center">
            <TextBlock Grid.Column="0" Text="Local Time:" Classes="Caption" VerticalAlignment="Center" />
            
            <icons:MaterialIcon Grid.Column="1" Kind="ClockOutline" Width="15" Height="15" Foreground="{DynamicResource LuminaPrimaryBrush}" VerticalAlignment="Center" />
            
            <TextBlock Grid.Column="2" 
                       Text="{Binding Player.FormattedLocalTime}" 
                       FontWeight="SemiBold" 
                       VerticalAlignment="Center" 
                       TextWrapping="Wrap" />
                       
            <Button Grid.Column="3" Classes="Ghost Icon" 
                    Command="{Binding CopyFieldCommand}" 
                    CommandParameter="{Binding Player.FormattedLocalTime}" 
                    ToolTip.Tip="Copy Local Time"
                    VerticalAlignment="Center">
              <icons:MaterialIcon Kind="ContentCopy" Width="14" Height="14" />
            </Button>
          </Grid>

          <Grid ColumnDefinitions="110,*,Auto" ColumnSpacing="8" VerticalAlignment="Center">
            <TextBlock Text="Name:" Classes="Caption" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding Player.Name}" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
            <Button Grid.Column="2" Classes="Ghost Icon" Command="{Binding CopyFieldCommand}" CommandParameter="{Binding Player.Name}">
              <icons:MaterialIcon Kind="ContentCopy" Width="14" Height="14" />
            </Button>
          </Grid>

          <Grid ColumnDefinitions="110,*,Auto" ColumnSpacing="8" VerticalAlignment="Center">
            <TextBlock Text="BattlEye GUID:" Classes="Caption" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding Player.Guid}" VerticalAlignment="Center" TextWrapping="Wrap" FontFamily="Consolas, monospace" FontSize="12" />
            <Button Grid.Column="2" Classes="Ghost Icon" Command="{Binding CopyFieldCommand}" CommandParameter="{Binding Player.Guid}">
              <icons:MaterialIcon Kind="ContentCopy" Width="14" Height="14" />
            </Button>
          </Grid>

          <Grid ColumnDefinitions="110,*,Auto" ColumnSpacing="8" VerticalAlignment="Center">
            <TextBlock Text="IP:Port:" Classes="Caption" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding Player.FormattedEndpoint}" VerticalAlignment="Center" FontFamily="Consolas, monospace" FontSize="12" />
            <Button Grid.Column="2" Classes="Ghost Icon" Command="{Binding CopyFieldCommand}" CommandParameter="{Binding Player.FormattedEndpoint}">
              <icons:MaterialIcon Kind="ContentCopy" Width="14" Height="14" />
            </Button>
          </Grid>

          <Grid ColumnDefinitions="110,*,Auto" ColumnSpacing="8" VerticalAlignment="Center">
            <TextBlock Text="Ping:" Classes="Caption" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding Player.PingDisplay}" VerticalAlignment="Center" />
          </Grid>

          <Grid ColumnDefinitions="110,*,Auto" ColumnSpacing="8" VerticalAlignment="Center">
            <TextBlock Text="Comment:" Classes="Caption" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding Player.Comment}" VerticalAlignment="Center" TextWrapping="Wrap" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
              <Button Classes="Ghost Icon" Command="{Binding EditCommentCommand}" ToolTip.Tip="Edit Comment">
                <icons:MaterialIcon Kind="PencilOutline" Width="14" Height="14" />
              </Button>
              <Button Classes="Ghost Icon" Command="{Binding CopyFieldCommand}" CommandParameter="{Binding Player.Comment}">
                <icons:MaterialIcon Kind="ContentCopy" Width="14" Height="14" />
              </Button>
            </StackPanel>
          </Grid>
        </StackPanel>

        <!-- Dialog Action Buttons -->
        <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,8,0,0">
          <Button Classes="Danger Outline" Content="Kick Player" Command="{Binding KickCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
          <Button Grid.Column="1" Classes="Danger" Content="Ban Player" Command="{Binding BanCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
        </Grid>
      </StackPanel>
    </ScrollViewer>
  </lumina:LuminaCard>
</UserControl>