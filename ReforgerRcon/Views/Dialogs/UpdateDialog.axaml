<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lumina="clr-namespace:LuminaUI.Controls;assembly=LuminaUI"
             xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vm="using:ReforgerRcon.ViewModels"
             x:Class="ReforgerRcon.Views.Dialogs.UpdateDialog"
             x:DataType="vm:UpdateDialogViewModel">

  <lumina:LuminaCard Padding="26" Width="520" Classes="Elevated" HorizontalAlignment="Center" VerticalAlignment="Center">
    <StackPanel Spacing="16">
      
      <!-- Header -->
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" VerticalAlignment="Center">
        <Border Grid.Column="0" 
                Background="{DynamicResource LuminaPrimaryBgBrush}" 
                CornerRadius="8" 
                Padding="10" 
                VerticalAlignment="Center">
          <icons:MaterialIcon Kind="RocketLaunchOutline" 
                             Foreground="{DynamicResource LuminaPrimaryBrush}" 
                             Width="24" Height="24" />
        </Border>

        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
          <TextBlock Text="Software Update Available" 
                     Classes="SectionTitle" 
                     FontSize="17" 
                     FontWeight="Bold" />
          <TextBlock Text="A new version of ARMA Reforger RCON Tool is available" 
                     FontSize="12" 
                     Foreground="{DynamicResource LuminaTextSecondaryBrush}" />
        </StackPanel>

        <Button Grid.Column="2" 
                Classes="Ghost Icon" 
                Content="✕" 
                Command="{Binding CloseCommand}" 
                IsEnabled="{Binding !IsDownloading}"
                ToolTip.Tip="Remind me on next startup" 
                VerticalAlignment="Center" />
      </Grid>

      <!-- Version Information Box -->
      <Border Background="{DynamicResource LuminaHoverBackgroundBrush}" 
              CornerRadius="6" 
              Padding="14,12">
        <Grid ColumnDefinitions="*,Auto,*" VerticalAlignment="Center">
          <!-- Current Version -->
          <StackPanel Grid.Column="0" Spacing="2" HorizontalAlignment="Center">
            <TextBlock Text="CURRENT VERSION" Classes="Caption" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" />
            <TextBlock Text="{Binding CurrentVersion, StringFormat='v{0}'}" 
                       FontWeight="Bold" FontSize="14" 
                       Foreground="{DynamicResource LuminaTextSecondaryBrush}" 
                       HorizontalAlignment="Center" />
          </StackPanel>

          <!-- Arrow -->
          <icons:MaterialIcon Grid.Column="1" Kind="ArrowRight" Width="22" Height="22" 
                             Foreground="{DynamicResource LuminaPrimaryBrush}" 
                             VerticalAlignment="Center" />

          <!-- Latest Version -->
          <StackPanel Grid.Column="2" Spacing="2" HorizontalAlignment="Center">
            <TextBlock Text="NEW VERSION" Classes="Caption" FontSize="10" FontWeight="SemiBold" 
                       Foreground="{DynamicResource LuminaSuccessBrush}" HorizontalAlignment="Center" />
            <TextBlock Text="{Binding LatestVersion, StringFormat='v{0}'}" 
                       FontWeight="Bold" FontSize="15" 
                       Foreground="{DynamicResource LuminaSuccessBrush}" 
                       HorizontalAlignment="Center" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- Release Notes Link Button -->
      <Button Classes="Outline Small" 
              Command="{Binding OpenReleaseNotesCommand}" 
              HorizontalAlignment="Center">
        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <icons:MaterialIcon Kind="OpenInNew" Width="14" Height="14" Foreground="{DynamicResource LuminaPrimaryBrush}" />
          <TextBlock Text="View Release Notes &amp; Changelog on GitHub" FontSize="12" />
        </StackPanel>
      </Button>

      <!-- Download Progress Area -->
      <StackPanel Spacing="6" IsVisible="{Binding IsDownloading}">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="{Binding StatusText}" Classes="Caption" FontSize="11" TextTrimming="CharacterEllipsis" />
          <TextBlock Grid.Column="1" Text="{Binding DownloadProgress, StringFormat='{}{0}%'}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource LuminaPrimaryBrush}" />
        </Grid>
        <ProgressBar Minimum="0" Maximum="100" Value="{Binding DownloadProgress}" Height="8" CornerRadius="4" />
      </StackPanel>

      <!-- Success Banner -->
      <Border Background="{DynamicResource LuminaSuccessBgBrush}" 
              BorderBrush="{DynamicResource LuminaSuccessBrush}" 
              BorderThickness="1" CornerRadius="6" Padding="10" 
              IsVisible="{Binding IsReadyToRestart}">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <icons:MaterialIcon Kind="CheckCircleOutline" Width="18" Height="18" Foreground="{DynamicResource LuminaSuccessBrush}" VerticalAlignment="Center" />
          <TextBlock Text="Update downloaded. Restart now to apply." FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource LuminaSuccessBrush}" VerticalAlignment="Center" />
        </StackPanel>
      </Border>

      <!-- Error Banner -->
      <Border Background="{DynamicResource LuminaDangerBgBrush}" 
              BorderBrush="{DynamicResource LuminaDangerBrush}" 
              BorderThickness="1" CornerRadius="6" Padding="10" 
              IsVisible="{Binding HasFailed}">
        <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource LuminaDangerBrush}" FontSize="12" TextWrapping="Wrap" />
      </Border>

      <!-- Action Footer -->
      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10" Margin="0,4,0,0">
        <!-- Close / Later -->
        <Button Grid.Column="1" 
                Classes="Outline" 
                Content="Later" 
                Command="{Binding CloseCommand}" 
                IsEnabled="{Binding !IsDownloading}"
                IsVisible="{Binding !IsReadyToRestart}"
                MinWidth="90" 
                HorizontalContentAlignment="Center" />

        <!-- Download & Update Now -->
        <Button Grid.Column="2" 
                Classes="Primary" 
                Content="Update Now" 
                Command="{Binding StartUpdateCommand}" 
                lumina:LuminaButton.IsLoading="{Binding IsDownloading}"
                IsVisible="{Binding !IsReadyToRestart}"
                MinWidth="130" 
                HorizontalContentAlignment="Center" />

        <!-- Restart & Apply Button -->
        <Button Grid.Column="2" 
                Classes="Success" 
                Content="Restart &amp; Apply Now" 
                Command="{Binding RestartAndApplyCommand}" 
                IsVisible="{Binding IsReadyToRestart}"
                MinWidth="160" 
                HorizontalContentAlignment="Center" />
      </Grid>
    </StackPanel>
  </lumina:LuminaCard>
</UserControl>