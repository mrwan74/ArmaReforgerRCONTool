<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lumina="clr-namespace:LuminaUI.Controls;assembly=LuminaUI"
             xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vm="using:ReforgerRcon.ViewModels"
             xmlns:tabs="using:ReforgerRcon.Views.Tabs"
             xmlns:dialogs="using:ReforgerRcon.Views.Dialogs"
             xmlns:converters="using:ReforgerRcon.Converters"
             x:Class="ReforgerRcon.Views.DashboardView"
             x:DataType="vm:DashboardViewModel">

  <Grid RowDefinitions="Auto,Auto,Auto,*">
    <!-- Top Header Bar -->
    <Border Grid.Row="0" Background="{DynamicResource LuminaSurfaceBrush}" BorderBrush="{DynamicResource LuminaBorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="18,12">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
          <Border Width="12" Height="12" CornerRadius="6"
                  Background="{DynamicResource LuminaSuccessBrush}"
                  IsVisible="{Binding IsConnected}"
                  Opacity="{Binding IsHeartbeatVisible, Converter={x:Static converters:BooleanToOpacityConverter.Instance}}" />

          <Border Width="12" Height="12" CornerRadius="6" Background="{DynamicResource LuminaDangerBrush}"
                  IsVisible="{Binding !IsConnected}" />

          <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
            <TextBlock Text="{Binding Profile.ServerIp, StringFormat='{}{0}:'}" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource LuminaTextPrimaryBrush}" />
            <TextBlock Text="{Binding Profile.Port}" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource LuminaTextPrimaryBrush}" />
          </StackPanel>

          <Border Padding="8,3" CornerRadius="4" Background="{DynamicResource LuminaPrimaryBgBrush}">
            <TextBlock Text="{Binding Profile.Protocol}" FontSize="12" Foreground="{DynamicResource LuminaPrimaryBrush}" FontWeight="Bold" />
          </Border>

          <TextBlock Text="{Binding Ping, StringFormat='Ping: {0}ms'}" FontSize="13" Foreground="{DynamicResource LuminaTextSecondaryBrush}" VerticalAlignment="Center" />
          <TextBlock Text="•" FontSize="13" Foreground="{DynamicResource LuminaTextTertiaryBrush}" VerticalAlignment="Center" />
          <TextBlock Text="{Binding LastPacketTimerText, StringFormat='Last packet: {0}'}" FontSize="13" Foreground="{DynamicResource LuminaTextSecondaryBrush}" VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
          <Button Classes="Danger Outline" Content="Disconnect" Command="{Binding DisconnectCommand}" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Stats & Auto-Refresh Bar with Skeletons -->
    <Border Grid.Row="1" Background="{DynamicResource LuminaNavigationPaneBrush}" Padding="18,10" BorderBrush="{DynamicResource LuminaBorderSubtleBrush}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,Auto,Auto,*" VerticalAlignment="Center">
        
        <!-- Online Players Stat Counter with Skeleton -->
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,28,0">
          <TextBlock Text="Online Players:" FontSize="13" Foreground="{DynamicResource LuminaTextSecondaryBrush}" VerticalAlignment="Center" />
          <lumina:LuminaSkeletonContainer IsLoading="{Binding IsOnlinePlayersLoading}" VerticalAlignment="Center">
            <lumina:LuminaSkeletonContainer.SkeletonContent>
              <lumina:LuminaSkeleton Width="32" Height="18" CornerRadius="4" />
            </lumina:LuminaSkeletonContainer.SkeletonContent>
            <TextBlock Text="{Binding OnlinePlayersCount}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource LuminaPrimaryBrush}" VerticalAlignment="Center" />
          </lumina:LuminaSkeletonContainer>
        </StackPanel>

        <!-- Active Bans Stat Counter with Skeleton -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,28,0">
          <TextBlock Text="Active Bans:" FontSize="13" Foreground="{DynamicResource LuminaTextSecondaryBrush}" VerticalAlignment="Center" />
          <lumina:LuminaSkeletonContainer IsLoading="{Binding IsActiveBansLoading}" VerticalAlignment="Center">
            <lumina:LuminaSkeletonContainer.SkeletonContent>
              <lumina:LuminaSkeleton Width="32" Height="18" CornerRadius="4" />
            </lumina:LuminaSkeletonContainer.SkeletonContent>
            <TextBlock Text="{Binding ActiveBansCount}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource LuminaDangerBrush}" VerticalAlignment="Center" />
          </lumina:LuminaSkeletonContainer>
        </StackPanel>

        <!-- BattlEye Connected Admins Button with Skeleton -->
        <Button Grid.Column="2" Classes="Small Ghost" 
                Command="{Binding OpenAdminsDialogCommand}"
                IsVisible="{Binding IsBattlEyeProtocol}"
                ToolTip.Tip="View connected RCON administrators">
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <icons:MaterialIcon Kind="AccountSupervisor" Width="16" Height="16" Foreground="{DynamicResource LuminaPrimaryBrush}" />
            <TextBlock Text="RCON Admins:" FontSize="13" Foreground="{DynamicResource LuminaTextSecondaryBrush}" VerticalAlignment="Center" />
            <lumina:LuminaSkeletonContainer IsLoading="{Binding IsAdminsLoading}" VerticalAlignment="Center">
              <lumina:LuminaSkeletonContainer.SkeletonContent>
                <lumina:LuminaSkeleton Width="24" Height="16" CornerRadius="4" />
              </lumina:LuminaSkeletonContainer.SkeletonContent>
              <TextBlock Text="{Binding ConnectedAdminsCount}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource LuminaPrimaryBrush}" VerticalAlignment="Center" />
            </lumina:LuminaSkeletonContainer>
          </StackPanel>
        </Button>

        <!-- Refresh Button & Countdown Progress Display -->
        <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12" VerticalAlignment="Center">
          <Button Classes="Outline Small" Command="{Binding RefreshAllCommand}" ToolTip.Tip="Manually refresh all server data now">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <icons:MaterialIcon Kind="Refresh" Width="14" Height="14" />
              <TextBlock Text="Refresh" />
            </StackPanel>
          </Button>

          <TextBlock Text="{Binding RefreshCountdownText}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource LuminaTextSecondaryBrush}" VerticalAlignment="Center" />
          <ProgressBar Width="120" Height="8" CornerRadius="4" Minimum="0" Maximum="100" Value="{Binding RefreshProgress}" VerticalAlignment="Center" IsVisible="{Binding IsAutoRefreshEnabled}" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Global Search Filter Bar -->
    <Border Grid.Row="2" Background="{DynamicResource LuminaSurfaceBrush}" Padding="16,8" BorderBrush="{DynamicResource LuminaBorderSubtleBrush}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="140,*" ColumnSpacing="12">
        <ComboBox ItemsSource="{Binding SearchTypes}" SelectedItem="{Binding SearchType}" HorizontalAlignment="Stretch" />
        <TextBox Grid.Column="1" Text="{Binding SearchQuery}" PlaceholderText="Type to filter players, bans or database..." />
      </Grid>
    </Border>

    <!-- Main View Area with Lazy Tabs -->
    <Grid Grid.Row="3">
      <Grid.RowDefinitions>
        <RowDefinition Height="{Binding TabsRowHeight}" />
        <RowDefinition Height="{Binding SplitterRowHeight}" />
        <RowDefinition Height="{Binding ConsoleRowHeight}" />
      </Grid.RowDefinitions>

      <TabControl Grid.Row="0" Classes="Line" SelectedIndex="0" Padding="0" IsVisible="{Binding !IsConsoleFullscreen}">
        <TabControl.DataTemplates>
          <DataTemplate DataType="{x:Type vm:PlayersViewModel}">
            <tabs:PlayersTabView />
          </DataTemplate>
          <DataTemplate DataType="{x:Type vm:BansViewModel}">
            <tabs:BansTabView />
          </DataTemplate>
          <DataTemplate DataType="{x:Type vm:DatabaseViewModel}">
            <tabs:DatabaseTabView />
          </DataTemplate>
          <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <tabs:SettingsTabView />
          </DataTemplate>
        </TabControl.DataTemplates>

        <TabItem Header="Players" Content="{Binding PlayersTab}" />
        <TabItem Header="Bans" Content="{Binding BansTab}" />
        <TabItem Header="Players Database" Content="{Binding DatabaseTab}" />
        <TabItem Header="Settings" Content="{Binding SettingsTab}" />
      </TabControl>

      <GridSplitter Grid.Row="1"
                    ResizeDirection="Rows"
                    Height="8"
                    Background="{DynamicResource LuminaSurfaceBrush}"
                    ShowsPreview="True"
                    IsVisible="{Binding !IsConsoleDetached}">
        <GridSplitter.Template>
          <ControlTemplate>
            <Border Background="{DynamicResource LuminaSurfaceBrush}" 
                    BorderBrush="{DynamicResource LuminaBorderSubtleBrush}" 
                    BorderThickness="0,1" 
                    Height="8" 
                    Cursor="SizeNorthSouth">
              <Border Width="48" Height="3" CornerRadius="1.5"
                      Background="{DynamicResource LuminaBorderDefaultBrush}"
                      HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </GridSplitter.Template>
      </GridSplitter>

      <Border Grid.Row="2" 
              Background="{DynamicResource LuminaSurfaceBrush}" 
              BorderBrush="{DynamicResource LuminaBorderSubtleBrush}" 
              BorderThickness="0,1,0,0"
              IsVisible="{Binding !IsConsoleDetached}">
        <tabs:ConsoleTabView DataContext="{Binding ConsoleTab}" />
      </Border>
    </Grid>

    <!-- Modal Dialog Overlay -->
    <Border Grid.Row="0" Grid.RowSpan="4" Background="#90000000" IsVisible="{Binding IsDialogVisible}" ZIndex="9000">
      <ContentControl Content="{Binding ActiveDialog}" HorizontalAlignment="Center" VerticalAlignment="Center">
        <ContentControl.DataTemplates>
          <DataTemplate DataType="{x:Type vm:PlayerDetailViewModel}">
            <dialogs:PlayerDetailDialog />
          </DataTemplate>
          <DataTemplate DataType="{x:Type vm:DatabasePlayerDetailViewModel}">
            <dialogs:DatabasePlayerDetailDialog />
          </DataTemplate>
          <DataTemplate DataType="{x:Type vm:BanDialogViewModel}">
            <dialogs:BanDialog />
          </DataTemplate>
          <DataTemplate DataType="{x:Type vm:KickDialogViewModel}">
            <dialogs:KickDialog />
          </DataTemplate>
          <DataTemplate DataType="{x:Type vm:GlobalMessageDialogViewModel}">
            <dialogs:GlobalMessageDialog />
          </DataTemplate>
          <DataTemplate DataType="{x:Type vm:AnnouncementDialogViewModel}">
            <dialogs:AnnouncementDialog />
          </DataTemplate>
          <DataTemplate DataType="{x:Type vm:OfflineBanDialogViewModel}">
            <dialogs:OfflineBanDialog />
          </DataTemplate>
          <DataTemplate DataType="{x:Type vm:SetCommentDialogViewModel}">
            <dialogs:SetCommentDialog />
          </DataTemplate>
          <DataTemplate DataType="{x:Type vm:ConfirmDialogViewModel}">
            <dialogs:ConfirmDialog />
          </DataTemplate>
          <DataTemplate DataType="{x:Type vm:ErrorDetailsDialogViewModel}">
            <dialogs:ErrorDetailsDialog />
          </DataTemplate>
          <DataTemplate DataType="{x:Type vm:ProtocolHelpDialogViewModel}">
            <dialogs:ProtocolHelpDialog />
          </DataTemplate>
          <DataTemplate DataType="{x:Type vm:ConnectionLostDialogViewModel}">
            <dialogs:ConnectionLostDialog />
          </DataTemplate>
          <DataTemplate DataType="{x:Type vm:AdminsDialogViewModel}">
            <dialogs:AdminsDialog />
          </DataTemplate>
          <DataTemplate DataType="{x:Type vm:GeoIpUpdateDialogViewModel}">
            <dialogs:GeoIpUpdateDialog />
          </DataTemplate>
          <DataTemplate DataType="{x:Type vm:BanImportPreviewViewModel}">
            <dialogs:BanImportPreviewDialog />
          </DataTemplate>
        </ContentControl.DataTemplates>
      </ContentControl>
    </Border>
  </Grid>
</UserControl>