<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lumina="clr-namespace:LuminaUI;assembly=LuminaUI"
             xmlns:dataGrid="clr-namespace:LuminaUI.DataGrid;assembly=LuminaUI.DataGrid"
             xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="ReforgerRcon.App"
             Name="ARMA REFORGER RCON TOOL (ARRT) V0.6.2"
             RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme />
    <lumina:LuminaTheme />
    <dataGrid:LuminaDataGridTheme />
    <icons:MaterialIconStyles />

    <!-- Global ToolTip Text Wrapping & Sizing (Fixes ToolTip Cut-Off) -->
    <Style Selector="ToolTip">
      <Setter Property="MaxWidth" Value="360" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>

    <Style Selector="ToolTip TextBlock">
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Remove cell focus border / CurrencyVisual rectangle on cell click -->
    <Style Selector="DataGridCell">
      <Setter Property="FocusAdorner" Value="{x:Null}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <Style Selector="DataGridCell /template/ Rectangle#CurrencyVisual">
      <Setter Property="IsVisible" Value="False" />
      <Setter Property="Opacity" Value="0" />
    </Style>

    <Style Selector="DataGridCell:current /template/ Rectangle#CurrencyVisual">
      <Setter Property="IsVisible" Value="False" />
      <Setter Property="Opacity" Value="0" />
    </Style>

    <Style Selector="DataGridCell:focus /template/ Grid#FocusVisual">
      <Setter Property="IsVisible" Value="False" />
      <Setter Property="Opacity" Value="0" />
    </Style>

    <Style Selector="DataGridCell /template/ Grid#FocusVisual">
      <Setter Property="IsVisible" Value="False" />
      <Setter Property="Opacity" Value="0" />
    </Style>

    <Style Selector="DataGridCell:current">
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <Style Selector="DataGridCell:focus">
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <Style Selector="DataGridCell:selected:focus">
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <Style Selector="DataGridCell:selected:current">
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
  </Application.Styles>
</Application>