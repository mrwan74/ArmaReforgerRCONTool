<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<LangVersion>latest</LangVersion>
		<Nullable>enable</Nullable>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<BuiltInComInteropSupport Condition="$([MSBuild]::IsOSPlatform('Windows'))">true</BuiltInComInteropSupport>
		<ApplicationManifest Condition="$([MSBuild]::IsOSPlatform('Windows'))">app.manifest</ApplicationManifest>
		<AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>

		<!-- Executable Output & Assembly Name (Generates "ARMA REFORGER RCON TOOL.exe") -->
		<AssemblyName>ARMA REFORGER RCON TOOL</AssemblyName>

		<!-- Task Manager Application Name, Product & Publisher Details -->
		<AssemblyTitle>ARMA REFORGER RCON TOOL (ARRT)</AssemblyTitle>
		<Product>ARMA REFORGER RCON TOOL (ARRT)</Product>
		<Description>ARMA REFORGER RCON TOOL (ARRT)</Description>
		<Company>mrwan74</Company>

		<!-- High-Performance Startup & Optimization Settings (.NET 10) -->
		<TieredCompilation>true</TieredCompilation>
		<TieredCompilationQuickJit>true</TieredCompilationQuickJit>
		<TieredCompilationQuickJitForLoops>true</TieredCompilationQuickJitForLoops>
		<TieredPGO>true</TieredPGO>
		<ServerGarbageCollection>false</ServerGarbageCollection>
		<PublishReadyToRun>true</PublishReadyToRun>
		<PublishReadyToRunShowWarnings>false</PublishReadyToRunShowWarnings>
		<PublishSingleFile>true</PublishSingleFile>
		<IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>

		<!-- Debug Symbol Packaging Configuration -->
		<DebugType>portable</DebugType>
		<DebugSymbols>true</DebugSymbols>

		<!-- Application Versioning (Read by Velopack, Aptabase, Sentry, and Windows File Properties) -->
		<Version>0.9.0-alpha.4</Version>
		<AssemblyVersion>0.9.0.0</AssemblyVersion>
		<FileVersion>0.9.0.0</FileVersion>
		<InformationalVersion>0.9.0-alpha.4</InformationalVersion>
		<NeutralLanguage>en</NeutralLanguage>

		<!-- Suppressed Analyzer & IDE Code-Style Warnings -->
		<NoWarn>$(NoWarn);CRRSP01;CRRSP02;CRRSP03;CRRSP04;CRRSP05;CRRSP06;CRRSP07;CRRSP08;S3776;S4136;S101;CA1711;MC8000;IDE0008;IDE0022;IDE0046;IDE0032;IDE0058;IDE0059;IDE0290</NoWarn>

		<!-- Recommended Roslyn Analyzers without CLI Warning Spam -->
		<EnableNETAnalyzers>true</EnableNETAnalyzers>
		<AnalysisLevel>latest-recommended</AnalysisLevel>
		<AnalysisMode>Recommended</AnalysisMode>
		<EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>

		<ApplicationIcon>Assets\app.ico</ApplicationIcon>
	</PropertyGroup>

	<!-- Retained Debug XAML Metadata & Diagnostics -->
	<PropertyGroup Label="Avalonia">
		<AvaloniaXamlCreateSourceInfo>True</AvaloniaXamlCreateSourceInfo>
		<AvaloniaXamlIlDebuggerLaunch>False</AvaloniaXamlIlDebuggerLaunch>
		<AvaloniaXamlVerboseExceptions>True</AvaloniaXamlVerboseExceptions>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\Aptabase.Avalonia\Aptabase.Avalonia.csproj" />
	</ItemGroup>

	<ItemGroup>
		<AvaloniaResource Include="Assets\**" />
		<AvaloniaResource Remove="Assets\sentry_dsn.txt" />
		<AvaloniaResource Remove="Assets/sentry_dsn.txt" />
		<AvaloniaResource Remove="Assets\aptabase_app_key.txt" />
		<AvaloniaResource Remove="Assets/aptabase_app_key.txt" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Avalonia" Version="12.1.2" />
		<PackageReference Include="Avalonia.Desktop" Version="12.1.2" />
		<PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.2" />
		<PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.2" />
		<PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3" />
		<PackageReference Include="Avalonia.Labs.Notifications" Version="12.0.2" />
		<PackageReference Include="NetCoreAudio" Version="2.0.1" />
		<PackageReference Include="Svg.Controls.Skia.Avalonia" Version="12.0.0.17" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
		<PackageReference Include="Material.Icons.Avalonia" Version="3.0.2" />
		<PackageReference Include="LuminaUI" Version="0.6.9" />
		<PackageReference Include="LuminaUI.DataGrid" Version="0.6.9" />
		<PackageReference Include="MaxMind.GeoIP2" Version="6.1.0" />
		<PackageReference Include="TimeZoneConverter" Version="7.2.0" />
		<PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
		<PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
		<PackageReference Include="Ben.Demystifier" Version="0.4.1" />
		<PackageReference Include="Microsoft.Diagnostics.NETCore.Client" Version="0.2.745401" />
		<PackageReference Include="Sentry" Version="6.11.0" />
		<PackageReference Include="Sentry.Profiling" Version="6.11.0" />
		<PackageReference Include="Sentry.Serilog" Version="6.11.0" />
		<PackageReference Include="Serilog" Version="4.4.0" />
		<PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
		<PackageReference Include="Serilog.Sinks.Debug" Version="3.0.0" />
		<PackageReference Include="Serilog.Sinks.Async" Version="2.1.0" />
		<PackageReference Include="Serilog.Enrichers.Thread" Version="4.0.0" />
		<PackageReference Include="Serilog.Enrichers.Process" Version="3.0.0" />
		<PackageReference Include="Serilog.Enrichers.Demystifier" Version="1.0.3" />
		<PackageReference Include="Serilog.Exceptions" Version="8.4.0" />
		<PackageReference Include="Serilog.ExceptionalLogContext" Version="1.1.0" />
		<PackageReference Include="SerilogTimings" Version="3.1.0" />
		<PackageReference Include="Velopack" Version="1.2.0" />
	</ItemGroup>

	<ItemGroup>
		<None Update="GeoIP\**" CopyToOutputDirectory="PreserveNewest" />
		<None Update="geoip\**" CopyToOutputDirectory="PreserveNewest" />
		<None Update="appdata\geoip\**" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

	<ItemGroup>
		<Compile Update="Properties\Resources.Designer.cs">
			<DesignTime>True</DesignTime>
			<AutoGen>True</AutoGen>
			<DependentUpon>Resources.resx</DependentUpon>
		</Compile>
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Update="Properties\Resources.resx">
			<Generator>ResXFileCodeGenerator</Generator>
			<LastGenOutput>Resources.Designer.cs</LastGenOutput>
		</EmbeddedResource>
	</ItemGroup>
</Project>
