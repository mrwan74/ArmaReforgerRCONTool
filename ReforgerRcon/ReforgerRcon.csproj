<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<LangVersion>latest</LangVersion>
		<Nullable>enable</Nullable>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<BuiltInComInteropSupport Condition="$([MSBuild]::IsOSPlatform('Windows'))">true</BuiltInComInteropSupport>
		<ApplicationManifest Condition="$([MSBuild]::IsOSPlatform('Windows'))">app.manifest</ApplicationManifest>
		<AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
		<NoWarn>$(NoWarn);CRRSP01;CRRSP02;CRRSP03;CRRSP04;CRRSP05;CRRSP06;CRRSP07;CRRSP08</NoWarn>

		<!-- Windows Executable (.exe) Icon -->
		<ApplicationIcon>Assets\app.ico</ApplicationIcon>
	</PropertyGroup>

	<!-- Embed Assets as Avalonia Resources for XAML loading (strictly excluding secret files) -->
	<ItemGroup>
		<AvaloniaResource Include="Assets\**" />
		<AvaloniaResource Remove="Assets\sentry_dsn.txt" />
		<AvaloniaResource Remove="Assets/sentry_dsn.txt" />
	</ItemGroup>

	<!-- MSBuild Task: XOR-Obfuscate and Embed Sentry DSN into C# Source during Build & Publish -->
	<UsingTask TaskName="GenerateTelemetrySecretsTask" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
		<ParameterGroup>
			<CandidateFile ParameterType="System.String" Required="false" />
			<EnvDsn ParameterType="System.String" Required="false" />
			<OutputFile ParameterType="System.String" Required="true" />
		</ParameterGroup>
		<Task>
			<Using Namespace="System" />
			<Using Namespace="System.IO" />
			<Using Namespace="System.Text" />
			<Code Type="Fragment" Language="cs">
				<![CDATA[
					string dsn = string.Empty;
					if (!string.IsNullOrEmpty(CandidateFile) && File.Exists(CandidateFile))
					{
						dsn = File.ReadAllText(CandidateFile).Trim();
					}
					if (string.IsNullOrEmpty(dsn) && !string.IsNullOrEmpty(EnvDsn))
					{
						dsn = EnvDsn.Trim();
					}

					byte[] xorKey = new byte[] { 0x41, 0x52, 0x52, 0x54, 0x5F, 0x53, 0x45, 0x4E, 0x54, 0x52, 0x59, 0x30, 0x38 }; // "ARRT_SENTRY08"
					byte[] rawBytes = Encoding.UTF8.GetBytes(dsn);
					byte[] obfuscated = new byte[rawBytes.Length];
					for (int i = 0; i < rawBytes.Length; i++)
					{
						obfuscated[i] = (byte)(rawBytes[i] ^ xorKey[i % xorKey.Length]);
					}

					string hexArray = rawBytes.Length > 0 ? "new byte[] { " + string.Join(", ", obfuscated) + " }" : "System.Array.Empty<byte>()";
					string keyArray = "new byte[] { " + string.Join(", ", xorKey) + " }";

					string code = @"// <auto-generated />
namespace ReforgerRcon.Services;

internal static class TelemetrySecrets
{
    private static readonly byte[] ObfuscatedDsn = " + hexArray + @";
    private static readonly byte[] XorKey = " + keyArray + @";

    public static string GetEmbeddedDsn()
    {
        if (ObfuscatedDsn.Length == 0) return string.Empty;
        byte[] decoded = new byte[ObfuscatedDsn.Length];
        for (int i = 0; i < ObfuscatedDsn.Length; i++)
        {
            decoded[i] = (byte)(ObfuscatedDsn[i] ^ XorKey[i % XorKey.Length]);
        }
        return System.Text.Encoding.UTF8.GetString(decoded);
    }
}";
					Directory.CreateDirectory(Path.GetDirectoryName(OutputFile));
					File.WriteAllText(OutputFile, code, Encoding.UTF8);
				]]>
			</Code>
		</Task>
	</UsingTask>

	<Target Name="GenerateObfuscatedTelemetrySecrets" BeforeTargets="BeforeCompile;CoreCompile">
		<PropertyGroup>
			<_CandidateDsnFile Condition="Exists('Assets/sentry_dsn.txt')">Assets/sentry_dsn.txt</_CandidateDsnFile>
			<_CandidateDsnFile Condition="'$(_CandidateDsnFile)' == '' and Exists('Assets\sentry_dsn.txt')">Assets\sentry_dsn.txt</_CandidateDsnFile>
			<_CandidateDsnFile Condition="'$(_CandidateDsnFile)' == '' and Exists('sentry_dsn.txt')">sentry_dsn.txt</_CandidateDsnFile>
			<_CandidateDsnFile Condition="'$(_CandidateDsnFile)' == '' and Exists('appdata/sentry_dsn.txt')">appdata/sentry_dsn.txt</_CandidateDsnFile>
			<_CandidateDsnFile Condition="'$(_CandidateDsnFile)' == '' and Exists('appdata\sentry_dsn.txt')">appdata\sentry_dsn.txt</_CandidateDsnFile>
			<_GeneratedTelemetrySecretsFile>$(IntermediateOutputPath)TelemetrySecrets.g.cs</_GeneratedTelemetrySecretsFile>
		</PropertyGroup>

		<GenerateTelemetrySecretsTask CandidateFile="$(_CandidateDsnFile)" EnvDsn="$(SENTRY_DSN)" OutputFile="$(_GeneratedTelemetrySecretsFile)" />

		<ItemGroup>
			<Compile Include="$(_GeneratedTelemetrySecretsFile)" />
			<FileWrites Include="$(_GeneratedTelemetrySecretsFile)" />
		</ItemGroup>
	</Target>

	<ItemGroup>
		<PackageReference Include="Avalonia" Version="12.1.1" />
		<PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
		<PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
		<PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
		<PackageReference Include="Svg.Controls.Skia.Avalonia" Version="12.0.0.16" />
		<PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
		<PackageReference Include="Material.Icons.Avalonia" Version="3.0.2" />
		<PackageReference Include="LuminaUI" Version="0.6.7" />
		<PackageReference Include="LuminaUI.DataGrid" Version="0.6.7" />
		<PackageReference Include="MaxMind.GeoIP2" Version="6.1.0" />
		<PackageReference Include="TimeZoneConverter" Version="7.2.0" />
		<PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
		<PackageReference Include="Ben.Demystifier" Version="0.4.1" />
		<PackageReference Include="Sentry" Version="6.9.0" />
		<PackageReference Include="Sentry.Profiling" Version="6.9.0" />
		<PackageReference Include="Sentry.Serilog" Version="6.9.0" />
		<PackageReference Include="Serilog" Version="4.4.0" />
		<PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
		<PackageReference Include="Serilog.Sinks.Debug" Version="3.0.0" />
		<PackageReference Include="Serilog.Sinks.Async" Version="2.1.0" />
		<PackageReference Include="Serilog.Enrichers.Thread" Version="4.0.0" />
		<PackageReference Include="Serilog.Enrichers.Process" Version="3.0.0" />
		<PackageReference Include="Serilog.Enrichers.Demystifier" Version="1.0.3" />
		<PackageReference Include="Serilog.Exceptions" Version="8.4.0" />
		<PackageReference Include="Serilog.ExceptionalLogContext" Version="1.1.0" />
		<PackageReference Include="SerilogTimings" Version="3.1.0" />
		<PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3" />
	</ItemGroup>

	<ItemGroup>
		<None Update="GeoIP/*.mmdb" CopyToOutputDirectory="PreserveNewest" />
		<None Update="geoip/*.mmdb" CopyToOutputDirectory="PreserveNewest" />
		<None Update="appdata/geoip/*.mmdb" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>
</Project>