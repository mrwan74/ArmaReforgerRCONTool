<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<LangVersion>latest</LangVersion>
		<Nullable>enable</Nullable>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<BuiltInComInteropSupport Condition="$([MSBuild]::IsOSPlatform('Windows'))">true</BuiltInComInteropSupport>
		<ApplicationManifest Condition="$([MSBuild]::IsOSPlatform('Windows'))">app.manifest</ApplicationManifest>
		<AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>

		<!-- Application Versioning (Read by Aptabase, Sentry, and Windows File Properties) -->
		<Version>0.8.64</Version>
		<AssemblyVersion>0.8.64.0</AssemblyVersion>
		<FileVersion>0.8.64.0</FileVersion>
		<InformationalVersion>0.8.64</InformationalVersion>
		<NeutralLanguage>en</NeutralLanguage>

		<!-- Suppressed Analyzer Warnings -->
		<NoWarn>$(NoWarn);CRRSP01;CRRSP02;CRRSP03;CRRSP04;CRRSP05;CRRSP06;CRRSP07;CRRSP08;S3776;S4136;S101;CA1711;MC8000</NoWarn>

		<!-- Recommended Roslyn Analyzers & Code Analysis Settings -->
		<EnableNETAnalyzers>true</EnableNETAnalyzers>
		<AnalysisLevel>latest-recommended</AnalysisLevel>
		<AnalysisMode>Recommended</AnalysisMode>
		<EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

		<ApplicationIcon>Assets\app.ico</ApplicationIcon>
	</PropertyGroup>
	<PropertyGroup Label="Avalonia">
		<AvaloniaXamlCreateSourceInfo>True</AvaloniaXamlCreateSourceInfo>
		<AvaloniaXamlIlDebuggerLaunch>False</AvaloniaXamlIlDebuggerLaunch>
		<AvaloniaXamlVerboseExceptions>True</AvaloniaXamlVerboseExceptions>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\Aptabase.Avalonia\Aptabase.Avalonia.csproj" />
	</ItemGroup>

	<ItemGroup>
		<AvaloniaResource Include="Assets\**" />
		<AvaloniaResource Remove="Assets\sentry_dsn.txt" />
		<AvaloniaResource Remove="Assets/sentry_dsn.txt" />
		<AvaloniaResource Remove="Assets\aptabase_app_key.txt" />
		<AvaloniaResource Remove="Assets/aptabase_app_key.txt" />
	</ItemGroup>

	<UsingTask TaskName="GenerateTelemetrySecretsTask" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
		<ParameterGroup>
			<CandidateDsnFile ParameterType="System.String" Required="false" />
			<CandidateAppKeyFile ParameterType="System.String" Required="false" />
			<EnvDsn ParameterType="System.String" Required="false" />
			<EnvAppKey ParameterType="System.String" Required="false" />
			<OutputFile ParameterType="System.String" Required="true" />
		</ParameterGroup>
		<Task>
			<Using Namespace="System" />
			<Using Namespace="System.IO" />
			<Using Namespace="System.Text" />
			<Code Type="Fragment" Language="cs">
				<![CDATA[
					string dsn = string.Empty;
					if (!string.IsNullOrEmpty(CandidateDsnFile) && File.Exists(CandidateDsnFile))
					{
						dsn = File.ReadAllText(CandidateDsnFile).Trim();
					}
					if (string.IsNullOrEmpty(dsn) && !string.IsNullOrEmpty(EnvDsn))
					{
						dsn = EnvDsn.Trim();
					}

					string appKey = "A-EU-3982497621";
					if (!string.IsNullOrEmpty(CandidateAppKeyFile) && File.Exists(CandidateAppKeyFile))
					{
						appKey = File.ReadAllText(CandidateAppKeyFile).Trim();
					}
					if (string.IsNullOrEmpty(appKey) && !string.IsNullOrEmpty(EnvAppKey))
					{
						appKey = EnvAppKey.Trim();
					}

					byte[] xorKey = new byte[] { 0x41, 0x52, 0x52, 0x54, 0x5F, 0x53, 0x45, 0x4E, 0x54, 0x52, 0x59, 0x30, 0x38 }; // "ARRT_SENTRY08"
					
					byte[] rawDsnBytes = Encoding.UTF8.GetBytes(dsn);
					byte[] obfuscatedDsn = new byte[rawDsnBytes.Length];
					for (int i = 0; i < rawDsnBytes.Length; i++)
					{
						obfuscatedDsn[i] = (byte)(rawDsnBytes[i] ^ xorKey[i % xorKey.Length]);
					}

					byte[] rawKeyBytes = Encoding.UTF8.GetBytes(appKey);
					byte[] obfuscatedKey = new byte[rawKeyBytes.Length];
					for (int i = 0; i < rawKeyBytes.Length; i++)
					{
						obfuscatedKey[i] = (byte)(rawKeyBytes[i] ^ xorKey[i % xorKey.Length]);
					}

					string hexDsnArray = rawDsnBytes.Length > 0 ? "new byte[] { " + string.Join(", ", obfuscatedDsn) + " }" : "System.Array.Empty<byte>()";
					string hexKeyArray = rawKeyBytes.Length > 0 ? "new byte[] { " + string.Join(", ", obfuscatedKey) + " }" : "System.Array.Empty<byte>()";
					string keyArray = "new byte[] { " + string.Join(", ", xorKey) + " }";

					string code = @"// <auto-generated />
namespace ReforgerRcon.Services;

internal static class TelemetrySecrets
{
    private static readonly byte[] ObfuscatedDsn = " + hexDsnArray + @";
    private static readonly byte[] ObfuscatedAppKey = " + hexKeyArray + @";
    private static readonly byte[] XorKey = " + keyArray + @";

    public static string GetEmbeddedDsn()
    {
        if (ObfuscatedDsn.Length == 0) return string.Empty;
        byte[] decoded = new byte[ObfuscatedDsn.Length];
        for (int i = 0; i < ObfuscatedDsn.Length; i++)
        {
            decoded[i] = (byte)(ObfuscatedDsn[i] ^ XorKey[i % XorKey.Length]);
        }
        return System.Text.Encoding.UTF8.GetString(decoded);
    }

    public static string GetEmbeddedAppKey()
    {
        if (ObfuscatedAppKey.Length == 0) return string.Empty;
        byte[] decoded = new byte[ObfuscatedAppKey.Length];
        for (int i = 0; i < ObfuscatedAppKey.Length; i++)
        {
            decoded[i] = (byte)(ObfuscatedAppKey[i] ^ XorKey[i % XorKey.Length]);
        }
        return System.Text.Encoding.UTF8.GetString(decoded);
    }
}";
					Directory.CreateDirectory(Path.GetDirectoryName(OutputFile));
					File.WriteAllText(OutputFile, code, Encoding.UTF8);
				]]>
			</Code>
		</Task>
	</UsingTask>

	<Target Name="GenerateObfuscatedTelemetrySecrets" BeforeTargets="BeforeCompile;CoreCompile">
		<PropertyGroup>
			<_CandidateDsnFile Condition="Exists('Assets/sentry_dsn.txt')">Assets/sentry_dsn.txt</_CandidateDsnFile>
			<_CandidateDsnFile Condition="'$(_CandidateDsnFile)' == '' and Exists('Assets\sentry_dsn.txt')">Assets\sentry_dsn.txt</_CandidateDsnFile>
			<_CandidateDsnFile Condition="'$(_CandidateDsnFile)' == '' and Exists('sentry_dsn.txt')">sentry_dsn.txt</_CandidateDsnFile>

			<_CandidateAppKeyFile Condition="Exists('Assets/aptabase_app_key.txt')">Assets/aptabase_app_key.txt</_CandidateAppKeyFile>
			<_CandidateAppKeyFile Condition="'$(_CandidateAppKeyFile)' == '' and Exists('Assets\aptabase_app_key.txt')">Assets\aptabase_app_key.txt</_CandidateAppKeyFile>
			<_CandidateAppKeyFile Condition="'$(_CandidateAppKeyFile)' == '' and Exists('aptabase_app_key.txt')">aptabase_app_key.txt</_CandidateAppKeyFile>

			<_GeneratedTelemetrySecretsFile>$(IntermediateOutputPath)TelemetrySecrets.g.cs</_GeneratedTelemetrySecretsFile>
		</PropertyGroup>

		<GenerateTelemetrySecretsTask CandidateDsnFile="$(_CandidateDsnFile)" CandidateAppKeyFile="$(_CandidateAppKeyFile)" EnvDsn="$(SENTRY_DSN)" EnvAppKey="$(APTABASE_APP_KEY)" OutputFile="$(_GeneratedTelemetrySecretsFile)" />

		<ItemGroup>
			<Compile Include="$(_GeneratedTelemetrySecretsFile)" />
			<FileWrites Include="$(_GeneratedTelemetrySecretsFile)" />
		</ItemGroup>
	</Target>

	<ItemGroup>
		<PackageReference Include="Avalonia" Version="12.1.1" />
		<PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
		<PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
		<PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
		<PackageReference Include="Avalonia.Labs.Notifications" Version="12.0.2" />
		<PackageReference Include="NetCoreAudio" Version="2.0.1" />
		<PackageReference Include="Svg.Controls.Skia.Avalonia" Version="12.0.0.17" />
		<PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
		<PackageReference Include="Material.Icons.Avalonia" Version="3.0.2" />
		<PackageReference Include="LuminaUI" Version="0.6.7" />
		<PackageReference Include="LuminaUI.DataGrid" Version="0.6.7" />
		<PackageReference Include="MaxMind.GeoIP2" Version="6.1.0" />
		<PackageReference Include="TimeZoneConverter" Version="7.2.0" />
		<PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
		<PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
		<PackageReference Include="Ben.Demystifier" Version="0.4.1" />
		<PackageReference Include="Sentry" Version="6.9.0" />
		<PackageReference Include="Sentry.Profiling" Version="6.9.0" />
		<PackageReference Include="Sentry.Serilog" Version="6.9.0" />
		<PackageReference Include="Serilog" Version="4.4.0" />
		<PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
		<PackageReference Include="Serilog.Sinks.Debug" Version="3.0.0" />
		<PackageReference Include="Serilog.Sinks.Async" Version="2.1.0" />
		<PackageReference Include="Serilog.Enrichers.Thread" Version="4.0.0" />
		<PackageReference Include="Serilog.Enrichers.Process" Version="3.0.0" />
		<PackageReference Include="Serilog.Enrichers.Demystifier" Version="1.0.3" />
		<PackageReference Include="Serilog.Exceptions" Version="8.4.0" />
		<PackageReference Include="Serilog.ExceptionalLogContext" Version="1.1.0" />
		<PackageReference Include="SerilogTimings" Version="3.1.0" />
	</ItemGroup>

	<ItemGroup>
		<None Update="GeoIP/*.mmdb" CopyToOutputDirectory="PreserveNewest" />
		<None Update="geoip/*.mmdb" CopyToOutputDirectory="PreserveNewest" />
		<None Update="appdata/geoip/*.mmdb" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

	<ItemGroup>
		<Compile Update="Properties\Resources.Designer.cs">
			<DesignTime>True</DesignTime>
			<AutoGen>True</AutoGen>
			<DependentUpon>Resources.resx</DependentUpon>
		</Compile>
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Update="Properties\Resources.resx">
			<Generator>ResXFileCodeGenerator</Generator>
			<LastGenOutput>Resources.Designer.cs</LastGenOutput>
		</EmbeddedResource>
	</ItemGroup>
</Project>